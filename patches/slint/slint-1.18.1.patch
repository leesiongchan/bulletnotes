+    pub(crate) fn visual_markers(self: Pin<&Self>) -> alloc::vec::Vec<super::TextInputMarker> {
+        use crate::model::Model;
+        let model = self.text_markers();
+        model.model_tracker().track_any_change(model.row_count(), crate::InternalToken);

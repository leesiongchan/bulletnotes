import { Theme, Typography, Radius, Spacing } from "components/theme.slint";
import { VerticalBox } from "std-widgets.slint";
import { ThemeScrollView } from "components/theme-scroll-view.slint";
import { SettingToggle, PageTitle } from "components/settings-controls.slint";
import { ActionButton, ChoiceButton } from "components/action-button.slint";
component ConnectionField inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    height: 36px;
    border-radius: Radius.tight;
    background: Theme.palette.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.palette.accent : Theme.palette.line;
    public function focus-field() { input.focus(); }
    input := TextInput {
        x: 10px; width: parent.width - 20px; height: parent.height;
        text <=> root.text;
        single-line: true; vertical-alignment: center;
        color: Theme.palette.ink; font-size: Typography.small;
        input-type: root.password ? InputType.password : InputType.text;
        selection-background-color: Theme.palette.cursor;
        selection-foreground-color: Theme.palette.ink;
        input-method-hints: { capitalization:none, auto-correct:false, auto-complete:false };
        accessible-label: root.label;
        enabled: root.enabled;
    }
    Text {
        x: 10px; width: parent.width - 20px; height: parent.height;
        text: root.placeholder; visible: root.text == "";
        color: Theme.palette.muted; font-size: Typography.body;
        vertical-alignment: center; accessible-role: none;
    }
}
export component ConnectionPanel inherits Rectangle {
    in-out property <string> server-url;
    in-out property <string> token;
    in-out property <bool> remember: false;
    in property <bool> busy: false;
    in property <bool> automatic-mode:false;
    in property <string> message;
    callback test-connection();
    callback return-to-note();
    public function focus-panel() { url.focus-field(); }
    background: transparent;
    PageTitle { x:Spacing.page; y:14px; text:"Connection"; }
    ActionButton {
        x: parent.width - 44px; y: 14px;
        icon: @image-url("../assets/icons/close.svg"); label: "Return to note";
        clicked => { root.return-to-note(); }
    }
    scroll := ThemeScrollView {
        scrollbar-color: Theme.palette.scrollbar;
        x:Spacing.page; y:54px; width:parent.width - 2 * Spacing.page; height:parent.height - 78px;
        content-width:self.visible-width; content-height:form.preferred-height;
        form := VerticalBox {
            x:0px;
            width:max(1px,scroll.visible-width - 12px); padding:0px; spacing:Spacing.lg;
            Text { text:"SilverBullet server"; color:Theme.palette.ink; font-size:Typography.small; }
            url := ConnectionField { text <=> root.server-url; label:"SilverBullet HTTPS server URL"; placeholder:"https://notes.example.com"; enabled: !root.busy; }
            Text { text:"Bearer token · optional"; color:Theme.palette.ink; font-size:Typography.small; }
            ConnectionField { text <=> root.token; password:true; label:"SilverBullet bearer token"; placeholder:"Leave blank to use Keychain or public access"; enabled:!root.busy; }
            SettingToggle { label:"Remember token securely"; checked <=> root.remember; enabled:!root.busy; }
            Text {
                text:(root.automatic-mode ? "Connecting uses one temporary page" : "Testing uses one temporary page") + " in Quick Notes/Bulletnotes Probe to check safe updates, then removes it. Your existing notes stay untouched.";
                wrap:word-wrap; color:Theme.palette.muted; font-size:Typography.body;
            }
            ChoiceButton { text:root.busy ? "Checking connection…" : (root.automatic-mode ? "Connect" : "Test connection"); enabled:!root.busy; clicked => { root.test-connection(); } }
            Text { text:root.message; wrap:word-wrap; color:Theme.palette.ink; font-size:Typography.small; }
        }
    }
}

import { ScrollView, ListView, VerticalBox } from "std-widgets.slint";
import { UiTheme, PageRow } from "types.slint";
import { ActionButton, ChoiceButton } from "components/action-button.slint";
component SourcePane inherits Rectangle {
    in property <UiTheme> theme;
    in-out property <string> text;
    in property <string> label;
    in property <bool> read-only:true;
    in property <int> focus-generation;
    changed focus-generation => { input.focus(); }
    callback edited();
    min-height:120px; preferred-height:140px;
    background:root.theme.surface;
    border-width:1px; border-color:root.theme.line; border-radius:6px; clip:true;
    ScrollView {
        width:parent.width; height:parent.height;
        content-width:self.visible-width; content-height:max(self.visible-height,input.preferred-height + 16px);
        input := TextInput {
            x:8px; y:8px; width:parent.visible-width - 16px;
            height:max(parent.visible-height - 16px,self.preferred-height);
            text <=> root.text; wrap:word-wrap; single-line:false; read-only:root.read-only;
            color:root.theme.ink; font-family:"Menlo"; font-size:12px;
            selection-background-color:root.theme.selection; selection-foreground-color:root.theme.ink;
            accessible-label:root.label;
            input-method-hints:{capitalization:none,auto-correct:false,auto-complete:false};
            edited => { root.edited(); }
        }
    }
}
export component RecoveryPanel inherits Rectangle {
    in property <UiTheme> theme;
    in-out property <string> section:"conflicts";
    in property <[PageRow]> items;
    in property <string> selected-id;
    in property <string> path;
    in property <string> local-text;
    in property <string> remote-text;
    in property <string> base-text;
    in property <bool> has-base:false;
    in property <bool> remote-deleted:false;
    in property <bool> selected:false;
    in property <bool> stale:false;
    in property <bool> writable:false;
    in property <bool> busy:false;
    in property <string> message;
    in-out property <string> merge-text;
    in-out property <string> destination;
    private property <bool> confirming-purge:false;
    callback return-to-note();
    callback section-changed();
    callback select-item(string);
    callback apply-choice(string);
    callback merge-edited();
    callback restore-item();
    callback purge-item();
    callback reload();
    private property <int> merge-focus-generation;
    public function focus-merge() { root.merge-focus-generation += 1; }
    public function focus-panel() { back.focus(); }
    background:root.theme.paper;
    Text { x:24px; y:14px; text:"Recovery"; font-size:17px; color:root.theme.ink; }
    back := ActionButton {
        x:parent.width - 44px; y:9px; theme:root.theme;
        icon:@image-url("../assets/icons/close.svg"); label:"Return to note";
        clicked => { root.return-to-note(); }
    }
    scroll := ScrollView {
        x:24px; y:54px; width:parent.width - 48px; height:parent.height - 68px;
        content-width:self.visible-width; content-height:form.preferred-height;
        form := VerticalBox {
            width:scroll.visible-width; padding:0px; spacing:10px;
            HorizontalLayout {
                spacing:6px;
                ChoiceButton { theme:root.theme; text:"Changes"; selected:root.section == "conflicts"; enabled:!root.busy; clicked => { root.section="conflicts"; root.confirming-purge=false; root.section-changed(); } }
                ChoiceButton { theme:root.theme; text:"Trash"; selected:root.section == "trash"; enabled:!root.busy; clicked => { root.section="trash"; root.confirming-purge=false; root.section-changed(); } }
                ChoiceButton { theme:root.theme; text:"Kept versions"; selected:root.section == "copies"; enabled:!root.busy; clicked => { root.section="copies"; root.confirming-purge=false; root.section-changed(); } }
            }
            Text { text:root.message; wrap:word-wrap; color:root.theme.muted; font-size:11px; }
            if root.items.length == 0:Text { text:root.section == "conflicts" ? "No changes need review." : "No saved copies here."; color:root.theme.ink; font-size:12px; }
            item-scroll := ListView {
                visible:root.items.length > 0; height:min(92px,root.items.length * 30px);
                content-width:self.visible-width;
                for item in root.items:ChoiceButton {
                    width:item-scroll.visible-width; height:30px;
                    theme:root.theme; text:item.title; label:"Review " + item.title;
                    selected:item.key == root.selected-id; enabled:!root.busy;
                    clicked => { root.confirming-purge=false; root.select-item(item.key); }
                }
            }
            if root.selected:Text { text:root.path; wrap:word-wrap; color:root.theme.ink; font-size:12px; }
            if root.selected:Text { text:root.section == "conflicts" ? "Your local version" : "Saved source"; color:root.theme.ink; font-size:12px; }
            if root.selected:SourcePane { theme:root.theme; text:root.local-text; label:root.section == "conflicts" ? "Local version" : "Saved recovery source"; }
            if root.selected && root.section == "conflicts":Text { text:root.remote-deleted ? "Remote page was deleted" : "Remote version"; color:root.theme.ink; font-size:12px; }
            if root.selected && root.section == "conflicts" && !root.remote-deleted:SourcePane { theme:root.theme; text:root.remote-text; label:"Remote version"; }
            if root.selected && root.section == "conflicts" && root.has-base:Text { text:"Common base"; color:root.theme.ink; font-size:12px; }
            if root.selected && root.section == "conflicts" && root.has-base:SourcePane { theme:root.theme; text:root.base-text; label:"Common base"; }
            if root.selected && root.section == "conflicts":Text { text:"Merged result"; color:root.theme.ink; font-size:12px; }
            if root.selected && root.section == "conflicts":SourcePane { theme:root.theme; text <=> root.merge-text; label:"Merged result"; focus-generation:root.merge-focus-generation; read-only:root.busy; edited => { root.merge-edited(); } }
            if root.selected && root.stale:ChoiceButton { theme:root.theme; text:"Reload changes · keep merged draft"; enabled:!root.busy; clicked => { root.reload(); } }
            if root.selected && root.section == "conflicts":HorizontalLayout {
                spacing:6px;
                ChoiceButton { theme:root.theme; text:root.remote-deleted ? "Accept deletion" : "Use remote"; enabled:!root.busy && !root.stale; clicked => { root.apply-choice("remote"); } }
                ChoiceButton { theme:root.theme; text:root.remote-deleted ? "Recreate local" : "Keep local"; enabled:!root.busy && !root.stale && root.writable; clicked => { root.apply-choice("local"); } }
                ChoiceButton { theme:root.theme; text:"Use merge"; enabled:!root.busy && !root.stale && root.writable; clicked => { root.apply-choice("merge"); } }
            }
            if root.selected && root.section != "conflicts":Text { text:"Restore destination · existing pages are preserved"; color:root.theme.ink; font-size:11px; wrap:word-wrap; }
            if root.selected && root.section != "conflicts":Rectangle {
                height:34px; background:root.theme.surface; border-width:1px; border-color:root.theme.line; border-radius:5px;
                TextInput { x:8px; width:parent.width - 16px; height:parent.height; text <=> root.destination; single-line:true; color:root.theme.ink; selection-background-color:root.theme.selection; selection-foreground-color:root.theme.ink; font-size:12px; vertical-alignment:center; accessible-label:"Recovery destination path"; read-only:root.busy; }
            }
            if root.selected && root.section != "conflicts":ChoiceButton { theme:root.theme; text:"Restore as a new page"; enabled:!root.busy; clicked => { root.restore-item(); } }
            if root.selected && root.section == "trash" && !root.confirming-purge:ChoiceButton { theme:root.theme; text:"Delete this local Trash copy…"; enabled:!root.busy; clicked => { root.confirming-purge=true; } }
            if root.selected && root.section == "trash" && root.confirming-purge:Text { text:"Permanently delete only this local Trash copy? This does not cancel pending remote deletion."; wrap:word-wrap; color:root.theme.ink; font-size:11px; }
            if root.selected && root.section == "trash" && root.confirming-purge:HorizontalLayout {
                spacing:6px;
                ChoiceButton { theme:root.theme; text:"Cancel"; enabled:!root.busy; clicked => { root.confirming-purge=false; } }
                ChoiceButton { theme:root.theme; text:"Delete local copy"; enabled:!root.busy; clicked => { root.confirming-purge=false; root.purge-item(); } }
            }
        }
    }
}

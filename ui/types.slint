export struct UiMarkdownColors {
    heading1: color,
    heading2: color,
    heading3: color,
    link: color,
    syntax: color
}
export struct UiTheme {
    paper: color,
    surface: color,
    ink: color,
    muted: color,
    accent: color,
    line: color,
    selection: color,
    cursor: color,
    scrollbar: color,
    pattern: color,
    markdown: UiMarkdownColors,
    dark: bool
}
export struct PageRow { checked: bool, can-promote: bool, can-trash: bool, trash-disabled-reason: string, list-excerpt: string, list-excerpt-highlights: [TextInputDecoration], key: string, title: string, path: string, excerpt: string, availability: string, modified-label: string, title-highlights: [TextInputDecoration], path-highlights: [TextInputDecoration], excerpt-highlights: [TextInputDecoration] }
export struct UiThemeSwatches {
    primary: color, secondary: color, tertiary: color,
    accent2: color, accent3: color, accent4: color, accent5: color, highlight: color
}
export struct ThemeOption { id: string, name: string, palette: UiTheme, swatches: UiThemeSwatches }
export struct ThemePair { left: ThemeOption, right: ThemeOption, has-right: bool }

export enum MarkdownCommand { toggle-task, continue-list, indent-list, outdent-list, bold, italic, strikethrough, cycle-heading, move-up, move-down }
export struct MarkdownEdit {
    handled: bool, changed: bool, start: int, end: int, replacement: string,
    anchor: int, caret: int, preserve-scroll: bool
}

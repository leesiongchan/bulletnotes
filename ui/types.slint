export struct UiTheme {
    paper: color,
    surface: color,
    ink: color,
    muted: color,
    accent: color,
    line: color,
    selection: color,
    cursor: color,
    scrollbar: color,
    pattern: color,
    dark: bool
}
export struct PageRow { key: string, title: string, path: string, excerpt: string, availability: string }
export struct ThemeOption { id: string, name: string, palette: UiTheme }
export struct ThemePair { left: ThemeOption, right: ThemeOption, has-right: bool }

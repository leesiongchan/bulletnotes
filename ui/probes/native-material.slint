import { ScrollView } from "std-widgets.slint";

// Disposable material/input composition probe. Never stores or synchronizes notes.
export component NativeMaterialWindow inherits Window {
    title: "Bulletnotes — material validation";
    preferred-width: 505px;
    preferred-height: 552px;
    min-width: 400px;
    min-height: 440px;
    no-frame: true;
    resize-border-width: 6px;
    background: transparent;
    in-out property <string> source <=> input.text;

    Rectangle {
        background: #fcfaf4.with-alpha(0.78);
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            WindowMoveArea {
                height: 28px;
                Text { text: "BULLETNOTES · NATIVE MATERIAL"; color: #353b32; font-size: 11px; vertical-alignment: center; }
            }
            scroll := ScrollView {
                content-width: self.visible-width;
                content-height: max(self.visible-height, input.preferred-height);
                input := TextInput {
                    width: scroll.visible-width;
                    height: max(scroll.visible-height, self.preferred-height);
                    text: "# A little space to think\n\nThis is translucent paper with opaque text.\n\nThe native background material sits behind this Slint editor.\n\n👩🏽‍💻 日本語 café\n\nTry selecting, typing, undo, and a real input method.\n\nThis is a disposable validation window.";
                    single-line: false;
                    wrap: word-wrap;
                    font-family: "Menlo";
                    font-size: 15px;
                    color: #353b32;
                    selection-background-color: #c5d6bf;
                    selection-foreground-color: #353b32;
                    accessible-label: "Material validation note";
                    cursor-position-changed(pos) => {
                        let line-height = self.font-metrics.ascent - self.font-metrics.descent;
                        if pos.y + scroll.content-y < 0px {
                            scroll.content-y = -pos.y;
                        } else if pos.y + scroll.content-y + line-height > scroll.visible-height {
                            scroll.content-y = scroll.visible-height - pos.y - line-height;
                        }
                    }
                }
            }
            Text { text: "Unsaved probe · no server connection"; color: #535d4d; font-size: 11px; }
        }
    }
}

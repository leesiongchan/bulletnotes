import { Theme, ThemeContext, Typography, Radius, Motion, Spacing } from "components/theme.slint";
import "../site/assets/fonts/dm-mono-italic.ttf";
import "../site/assets/fonts/dm-mono-medium.ttf";
import "../site/assets/fonts/dm-mono-medium-italic.ttf";
import "../site/assets/fonts/dm-mono.ttf";
import "../site/assets/fonts/dm-sans.ttf";
import { RecoveryAdapter, RecoveryPanel } from "recovery-view.slint";
import { ConnectionPanel } from "connection-view.slint";
import { Palette, AboutSlint } from "std-widgets.slint";
import { UiTheme, PageRow, ThemeOption, ThemePair, MarkdownCommand, MarkdownEdit, CodePanel, UiRecoveryKind, SettingsCategory, UiAppearanceMode, UiPaperIntensity, UiPaperStyle, UiPaperType, UiView } from "types.slint";
import { ActionButton } from "components/action-button.slint";
import { FindBar } from "components/find-bar.slint";
import { NoteEditor } from "components/note-editor.slint";
import { PageBrowser, SearchAdapter } from "components/page-browser.slint";
import { PaperSurface } from "components/paper-surface.slint";
import { AppearanceAdapter, AppearancePanel } from "components/appearance-panel.slint";
export { AppearanceAdapter, RecoveryAdapter, SearchAdapter }
export { UiTheme, PageRow, ThemeOption, ThemePair, MarkdownCommand, MarkdownEdit, CodePanel, UiView, SettingsCategory, UiRecoveryKind, UiAppearanceMode, UiPaperType, UiPaperStyle, UiPaperIntensity }

export component AppWindow inherits Window {
    default-font-family: Typography.sans;
    title: "Bulletnotes";
    icon: @image-url("../assets/bulletnotes-logo.png");
    preferred-width: 505px;
    preferred-height: 552px;
    min-width: 400px;
    min-height: 440px;
    background: transparent;
    no-frame: Platform.os == OperatingSystemType.macos;
    resize-border-width: 0px;
    always-on-top: root.is-pinned;
    in-out property <UiTheme> theme <=> Theme.palette;
    ThemeContext {}
    callback about-presentation-changed();
    changed prefers-reduced-transparency => { root.about-presentation-changed(); }
    callback search-palette-changed();
    changed system-high-contrast => { root.search-palette-changed(); root.about-presentation-changed(); }
    in-out property <UiView> active-view:UiView.note;
    in property <string> current-path;
    in-out property <string> note-text;
    pure callback edit-markdown(string, int, int, MarkdownCommand, int, int) -> MarkdownEdit;
    out property <int> editor-anchor: editor.selection-anchor;
    out property <int> editor-caret: editor.selection-caret;
    pure callback mark-markdown(string, UiTheme) -> [TextInputMarker];
    private property <[TextInputMarker]> note-markers: root.mark-markdown(root.note-text,root.theme);
    pure callback highlight-markdown(string, UiTheme, bool) -> [TextInputDecoration];
    private property <[TextInputDecoration]> note-decorations: root.highlight-markdown(root.note-text,root.theme,root.system-high-contrast);
    in property <string> status-text;
    in property <[CodePanel]> code-panels;
    in property <[TextInputMarker]> code-layout-markers;
    callback code-layout-changed();
    public function measure-code-offset(offset:int) -> float {return editor.measure-offset(offset);}
    in-out property <bool> is-pinned:false;
    in-out property <bool> header-hovered:false;
    in-out property <bool> footer-hovered:false;
    in-out property <bool> chrome-active:true;
    out property <bool> header-revealed:false;
    out property <bool> footer-revealed:false;
    out property <float> header-opacity:header.opacity;
    out property <float> footer-opacity:footer.opacity;
    out property <length> editor-height:editor.height;
    out property <length> editor-width:editor.width;
    private property <int> pending-chrome-focus:0;
    private property <bool> header-focused:pin.has-focus || browse.has-focus || appearance-button.has-focus || new-button.has-focus;
    private property <bool> footer-focused:trash-button.has-focus || newest.has-focus || back.has-focus || next.has-focus;
    private property <bool> header-needed:root.chrome-active && (root.header-hovered || root.pending-chrome-focus == 1 || root.header-focused || pin.pressed || browse.pressed || appearance-button.pressed || new-button.pressed);
    private property <bool> footer-needed:root.chrome-active && root.active-view == UiView.note && (root.keep-bottom-bar-visible || root.footer-hovered || root.pending-chrome-focus == 2 || root.footer-focused || trash-button.pressed || newest.pressed || back.pressed || next.pressed);
    callback header-visibility-changed(bool, bool);
    changed header-needed => { if (root.header-needed) { root.header-revealed = true; } }
    changed footer-needed => { if (root.footer-needed) { root.footer-revealed = true; } }
    changed header-revealed => { root.header-visibility-changed(root.header-revealed,root.prefers-reduced-motion || !root.chrome-active); }
    Timer { interval:root.active-view == UiView.note ? 300ms : 0ms; running:root.header-revealed && !root.header-needed; triggered => { root.header-revealed = false; } }
    Timer { interval:300ms; running:root.footer-revealed && !root.footer-needed; triggered => { root.footer-revealed = false; } }
    // Focus only after the reveal has a visible frame; Slint drops focus in hidden ancestors.
    Timer {
        interval:16ms; running:root.pending-chrome-focus != 0;
        triggered => {
            if (root.pending-chrome-focus == 1 && header.opacity > 0) { pin.focus(); root.pending-chrome-focus = 0; }
            else if (root.pending-chrome-focus == 2 && footer.opacity > 0) { trash-button.focus(); root.pending-chrome-focus = 0; }
        }
    }
    function focus-active-view() {
        if (root.active-view == UiView.pages) { pages.focus-query(); }
        else if (root.active-view == UiView.appearance) { appearance.focus-panel(); }
        else if (root.active-view == UiView.recovery) { auxiliary.focus-panel(); }
        else if (root.active-view == UiView.connection) { connection.focus-panel(); }
        else { editor.focus-editor(); }
    }
    public function reset-chrome() {
        if (root.header-focused || root.footer-focused) { root.focus-active-view(); }
        root.pending-chrome-focus = 0;
        root.chrome-active = false;
        root.header-hovered = false;
        root.footer-hovered = false;
        root.header-revealed = false;
        root.footer-revealed = false;
    }
    in property <bool> note-read-only:false;
    in property <bool> lifecycle-pending:false;
    private property <float> font-size-px: AppearanceAdapter.font-size-px;
    private property <UiPaperStyle> paper-style: AppearanceAdapter.paper-style;
    private property <UiPaperType> paper-type: AppearanceAdapter.paper-type;
    changed paper-type => { root.about-presentation-changed(); }
    changed paper-style => { root.about-presentation-changed(); }
    changed font-size-px => { root.about-presentation-changed(); }
    private property <bool> paper-material-active:Theme.material-effects && root.paper-type != UiPaperType.smooth;
    private property <bool> keep-bottom-bar-visible: AppearanceAdapter.keep-bottom-bar-visible;
    private property <bool> show-note-count: AppearanceAdapter.show-note-count;
    private property <bool> show-note-date: AppearanceAdapter.show-note-date;
    private property <string> visible-note-count:root.show-note-count ? root.note-counter : "";
    private property <string> visible-note-date:root.show-note-date ? root.note-date : "";
    in property <string> selected-theme-id;
    in property <string> note-counter;
    in property <string> note-date;
    in property <bool> can-go-older:false;
    in property <bool> can-go-newer:false;
    in property <bool> can-jump-to-newest:true;
    in property <bool> is-newest-scratchpad:false;
    in property <bool> status-attention:false;
    callback scratchpad-step(int);
    callback jump-to-newest();
    private property <bool> low-contrast-warning: AppearanceAdapter.low-contrast-warning;
    out property <float> editor-scroll-y:editor.scroll-y;
    out property <length> editor-line-height:editor.line-height;
    callback show-recovery();
    callback trash-current-note();
    callback save-now();
    in-out property <bool> find-visible:false;
    in-out property <string> find-query;
    in property <string> find-status;
    callback find-opened();
    callback find-query-changed(string);
    callback find-step(int);
    public function show-find() { if (root.active-view != UiView.note) { root.return-to-note(); } root.find-visible = true; find.focus-query(); root.find-opened(); }
    public function close-find() { root.find-visible = false; editor.focus-editor(); }
    public function select-find-match(anchor:int, caret:int) { editor.select-match(anchor,caret); }
    callback native-window-ready();
    callback native-preferences-changed();
    callback native-activation-changed();
    callback native-reopen-requested();
    callback export-diagnostics();
    callback show-about();
    callback native-geometry-changed();
    callback native-displays-changed();
    callback toggle-activation();
    callback window-will-hide();
    in property <bool> native-warning:false;
    in property <bool> can-hide-to-tray:true;
    property <string> shortcut-modifier:Platform.os == OperatingSystemType.macos ? "Command" : "Control";
    in-out property <bool> prefers-reduced-motion <=> Theme.reduced-motion;
    in-out property <bool> prefers-reduced-transparency <=> Theme.reduce-transparency;
    in-out property <bool> system-high-contrast <=> Theme.high-contrast;
    callback local-startup-ready();
    in property <bool> sync-available:false;
    callback request-quit();
    callback request-hide();
    callback browse-pages();
    callback open-page(string);
    callback new-note();
    callback show-appearance();
    callback show-connection();
    callback test-connection();
    in-out property <string> connection-url;
    in-out property <string> connection-token;
    in-out property <bool> connection-remember:false;
    in property <bool> connection-busy:false;
    in property <string> connection-message;
    callback return-to-note();
    callback note-edited(string);
    callback follow-link(string, int) -> bool;
    callback theme-assigned(string, bool);
    callback toggle-pin();
    public function focus-editor() { editor.focus-editor(); }
    public function restore-editor-position(anchor: int, caret: int, y: float) { editor.restore-selection(anchor,caret,y); }
    public function reveal-theme-choices() { appearance.reveal-themes(); }
    function shortcut(event: KeyEvent) -> EventResult {
        if (event.text == Key.F6) {
            root.chrome-active = true;
            if ((root.header-focused || root.pending-chrome-focus == 1) && root.active-view == UiView.note) {
                root.pending-chrome-focus = 2; root.footer-revealed = true;
            } else if (root.header-focused || root.footer-focused || root.pending-chrome-focus != 0) {
                root.pending-chrome-focus = 0; root.focus-active-view();
            } else { root.pending-chrome-focus = 1; root.header-revealed = true; }
            return accept;
        }
        if (event.text == Key.Escape && (root.header-focused || root.footer-focused || root.pending-chrome-focus != 0)) {
            root.pending-chrome-focus = 0; root.focus-active-view();
            return accept;
        }
        // Slint maps the macOS Command key to control.
        if (event.modifiers.control) {
            if (event.text == "f" || event.text == "F") { root.show-find(); return accept; }
            if ((event.text == "g" || event.text == "G") && root.active-view == UiView.note) { root.find-step(event.modifiers.shift ? -1 : 1); return accept; }
            if (event.text == "q" || event.text == "Q") { root.request-quit(); return accept; }
            if (event.text == "w" || event.text == "W") { root.request-hide(); return accept; }
            if (event.text == "s" || event.text == "S") { root.save-now(); return accept; }
            if (!event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && (event.text == "k" || event.text == "K")) { root.browse-pages(); return accept; }
            if (event.text == "1") { if (root.can-jump-to-newest) {root.jump-to-newest();} return accept; }
            if (event.text == "p" || event.text == "P") {root.toggle-pin();return accept;}
            if (event.text == "n" || event.text == "N") { root.new-note(); return accept; }
            if (event.text == ",") { root.show-appearance(); return accept; }
            if (event.text == "[") { root.scratchpad-step(-1); return accept; }
            if (event.text == "]") { root.scratchpad-step(1); return accept; }
        }
        if (event.text == Key.Escape && root.active-view == UiView.note && root.find-visible) { root.close-find(); return accept; }
        if (event.text == Key.Escape && root.active-view == UiView.pages) {
            if (!pages.escape-allowed) { return reject; }
            pages.cancel-or-close(); return accept;
        }
        if (event.text == Key.Escape && root.active-view != UiView.note) {
            if (root.low-contrast-warning) { AppearanceAdapter.cancel-theme-import(); } else { root.return-to-note(); }
            return accept;
        }
        return reject;
    }
    changed theme => {
        root.search-palette-changed();
        root.about-presentation-changed();
    }
    changed active-view => {
        if (root.active-view == UiView.pages) { pages.focus-query(); }
        else if (root.active-view == UiView.appearance) { appearance.focus-panel(); }
        else if (root.active-view == UiView.recovery) { auxiliary.focus-panel(); }
        else if (root.active-view == UiView.connection) { connection.focus-panel(); }
        else if (root.active-view == UiView.note) { editor.focus-editor(); }
        if (root.active-view != UiView.connection) { root.connection-token = ""; }
    }
    Rectangle {
        background: root.theme.paper;
        border-radius: Radius.window;
        clip: true;
        PaperSurface {
            width:parent.width; height:parent.height; visible:root.active-view != UiView.note;
            paper-type:root.paper-type; paper-style:root.paper-style;
            font-size-px:root.font-size-px;
        }
        keys := FocusScope {
            key-pressed(event) => { root.shortcut(event) }
            capture-key-pressed(event) => {
                if (event.text == Key.F6 || (event.text == Key.Escape && (root.header-focused || root.footer-focused || root.pending-chrome-focus != 0 || (root.active-view == UiView.pages && pages.escape-allowed)))) { return root.shortcut(event); }
                return reject;
            }
            // Retain the editor instance while other views are shown, preserving its native editing state.
            note-view := Rectangle {
                height: parent.height;
                width: parent.width;
                visible: root.active-view != UiView.pages && root.active-view != UiView.appearance && root.active-view != UiView.connection && root.active-view != UiView.recovery;
                editor := NoteEditor {
                    width: parent.width;
                    height: parent.height;
                    top-clearance:root.find-visible ? 93.75px : 33.75px;
                    paper-material:root.paper-material-active;
                    paper-type:root.paper-type;
                    text <=> root.note-text;
                    decorations: root.note-decorations;
                    markers: root.note-markers;
                    code-panels:root.code-panels; layout-markers:root.code-layout-markers;
                    code-layout-changed => {root.code-layout-changed();}
                    font-size-px: root.font-size-px;
                    paper-style: root.paper-style;
                    read-only: root.note-read-only || RecoveryAdapter.busy || root.lifecycle-pending || SearchAdapter.busy;
                    edit-markdown(source,anchor,caret,command,start,end) => { root.edit-markdown(source,anchor,caret,command,start,end) }
                    edited(text) => { root.note-edited(text); }
                    follow-link(source,caret) => { root.follow-link(source,caret) }
                    move-to-trash => { root.trash-current-note(); }
                    key-pressed(event) => { root.shortcut(event) }
                }

                find := FindBar {
                    y: 48px; height: 36px; width: parent.width;
                    visible: root.find-visible;
                    query <=> root.find-query; status: root.find-status;
                    query-changed(query) => { root.find-query-changed(query); }
                    step(direction) => { root.find-step(direction); }
                    close => { root.close-find(); }
                }

            }

            pages := PageBrowser {
                y: 20px;
                height: parent.height - 20px;
                width: parent.width;
                visible: root.active-view == UiView.pages;
                open-page(key) => { root.open-page(key); }
                return-to-note => { root.return-to-note(); }
            }

            appearance := AppearancePanel {
                y: 20px;
                height: parent.height - 20px;
                width: parent.width;
                visible: root.active-view == UiView.appearance;
                reduce-transparency:root.prefers-reduced-transparency;
                return-to-note => { root.return-to-note(); }
                show-connection => { root.show-connection(); }
                show-recovery => { root.show-recovery(); }
            }

            connection := ConnectionPanel {
                y:20px; height:parent.height - 20px; width:parent.width;
                visible:root.active-view == UiView.connection;
                server-url <=> root.connection-url;
                token <=> root.connection-token; remember <=> root.connection-remember;
                busy:root.connection-busy || root.lifecycle-pending; message:root.connection-message; automatic-mode:root.sync-available;
                test-connection => { root.test-connection(); }
                return-to-note => { root.return-to-note(); }
            }
            auxiliary := RecoveryPanel {
                y:20px; height:parent.height - 20px; width:parent.width;
                visible:root.active-view == UiView.recovery;
                lifecycle-pending:root.lifecycle-pending;
                return-to-note => { root.return-to-note(); }
            }
            Rectangle {
                x:20px; width:parent.width - 40px; height:48px; y:parent.height - 112px;
                visible:root.status-attention && root.active-view == UiView.note;
                background:root.theme.surface; border-radius:Radius.group; border-width:1px; border-color:root.theme.accent;
                Text {x:12px; width:parent.width - 24px; height:parent.height; text:root.status-text; color:root.theme.ink; font-size:Typography.caption; wrap:word-wrap; vertical-alignment:center;}
            }
            header := Rectangle {
                x:0px; y:root.prefers-reduced-motion || root.header-revealed ? 0px : -4px;
                width:parent.width; height:root.active-view == UiView.note ? 32px : 34px;
                background:root.theme.paper;
                border-width:root.system-high-contrast ? 1px : 0px; border-color:root.theme.line;
                opacity:root.header-revealed ? 1 : 0;
                visible:self.opacity > 0;
                animate opacity, y { duration:root.prefers-reduced-motion || !root.chrome-active ? 0ms : (root.header-revealed ? Motion.reveal : Motion.conceal); easing:ease-out; }
                WindowMoveArea {x:160px; width:max(0px,parent.width - 248px); height:parent.height; enabled:root.header-revealed;}
                appearance-button := ActionButton {
                    x:82px; y:root.active-view == UiView.note ? 0px : 1px; circular:true;
                    enabled:root.header-revealed && header.opacity > 0;
                    icon:@image-url("../assets/icons/appearance.svg"); label:"Settings, " + root.shortcut-modifier + " comma";
                    clicked => {root.show-appearance();}
                }
                browse := ActionButton {
                    x:120px; y:root.active-view == UiView.note ? 0px : 1px; circular:true;
                    enabled:root.header-revealed && header.opacity > 0;
                    icon:@image-url("../assets/icons/search.svg"); label:"Search all pages, " + root.shortcut-modifier + " K";
                    clicked => {root.browse-pages();}
                }
                Text {
                    x:164px; width:max(0px,parent.width - 252px); height:parent.height;
                    text:root.active-view == UiView.note ? root.current-path : "Bulletnotes";
                    accessible-label:root.current-path;
                    color:root.theme.muted; font-size:Typography.caption; overflow:elide;
                    horizontal-alignment:center; vertical-alignment:center;
                }
                new-button := ActionButton {
                    x:parent.width - 82px; y:root.active-view == UiView.note ? 0px : 1px; circular:true;
                    enabled:root.header-revealed && header.opacity > 0 && !root.lifecycle-pending;
                    icon:@image-url("../assets/icons/plus.svg"); label:"New scratchpad, " + root.shortcut-modifier + " N";
                    clicked => {root.new-note();}
                }
                pin := ActionButton {
                    x:parent.width - 42px; y:root.active-view == UiView.note ? 0px : 1px; circular:true;
                    enabled:root.header-revealed && header.opacity > 0;
                    icon:@image-url("../assets/icons/pin.svg");
                    label:root.is-pinned ? "Unpin note, " + root.shortcut-modifier + " P" : "Pin above other windows, " + root.shortcut-modifier + " P";
                    selected:root.is-pinned; clicked => {root.toggle-pin();}
                }
            }
            footer := Rectangle {
                y:parent.height - 54px + (root.prefers-reduced-motion || root.footer-revealed ? 0px : 4px);
                height:44px; x:10px; width:parent.width - 20px; border-radius:Radius.surface;
                border-width:root.system-high-contrast ? 1px : 0px; border-color:root.theme.ink;
                opacity:root.footer-revealed ? 1 : 0; visible:self.opacity > 0 && root.active-view == UiView.note;
                animate opacity, y {duration:root.prefers-reduced-motion || !root.chrome-active ? 0ms : (root.footer-revealed ? Motion.reveal : Motion.conceal); easing:ease-out;}
                background:root.system-high-contrast ? root.theme.paper : transparent;
                HorizontalLayout {
                    y:6px; width:parent.width; height:32px; padding-left:Spacing.sm; padding-right:Spacing.sm; spacing:Spacing.sm;
                    trash-button := ActionButton {
                        circular:true;
                        enabled:root.footer-revealed && footer.opacity > 0 && !root.note-read-only && !RecoveryAdapter.busy && !root.lifecycle-pending;
                        icon:@image-url("../assets/icons/trash.svg"); label:"Move note to recoverable Trash";
                        clicked => {root.trash-current-note();}
                    }
                    HorizontalLayout {
                        horizontal-stretch:1; spacing:Spacing.md;
                        Text {text:root.visible-note-count.is-empty ? root.visible-note-date : (root.visible-note-date.is-empty ? root.visible-note-count : root.visible-note-date + " · " + root.visible-note-count); color:root.theme.muted; font-size:Typography.small; vertical-alignment:center; overflow:elide;}
                        Text {visible:root.width > 560px; text:root.status-text; color:root.theme.muted; font-size:Typography.small; vertical-alignment:center; overflow:elide;}
                    }
                    back := ActionButton {
                        circular:true; icon:@image-url("../assets/icons/left.svg"); label:"Older scratchpad, " + root.shortcut-modifier + " left bracket";
                        enabled:root.footer-revealed && footer.opacity > 0 && root.can-go-older && !root.lifecycle-pending;
                        clicked => {root.scratchpad-step(-1);}
                    }
                    next := ActionButton {
                        circular:true; icon:@image-url("../assets/icons/right.svg"); label:"Newer scratchpad, " + root.shortcut-modifier + " right bracket";
                        enabled:root.footer-revealed && footer.opacity > 0 && root.can-go-newer && !root.lifecycle-pending;
                        clicked => {root.scratchpad-step(1);}
                    }
                    newest := ActionButton {
                        circular:true; icon:@image-url("../assets/icons/newest.svg"); label:"Jump to newest scratchpad, " + root.shortcut-modifier + " 1";
                        enabled:root.footer-revealed && footer.opacity > 0 && root.can-jump-to-newest && !root.lifecycle-pending;
                        clicked => {root.jump-to-newest();}
                    }

                }
            }



        }
    }
}

export component LocalTray inherits SystemTrayIcon {
    icon: Palette.color-scheme == ColorScheme.dark ? @image-url("../assets/native-preview-tray-dark.svg") : @image-url("../assets/native-preview-tray.svg");
    title: "";
    tooltip: "Bulletnotes";
    callback reopen();
    callback quit();
    callback show-about();
    callback export-diagnostics();
    Menu {
        MenuItem { title: "About Bulletnotes"; activated => { root.show-about(); } }
        MenuSeparator {}
        MenuItem { title: "Export diagnostics…"; activated => { root.export-diagnostics(); } }
        MenuItem { title: "Show Bulletnotes"; activated => { root.reopen(); } }
        MenuSeparator {}
        MenuItem { title: "Quit Bulletnotes"; activated => { root.quit(); } }
    }
}

export component AboutWindow inherits Window {
    default-font-family:Typography.sans;
    title:"About Bulletnotes";
    icon:@image-url("../assets/bulletnotes-logo.png");
    preferred-width:360px; preferred-height:300px;
    min-width:360px; min-height:300px;
    always-on-top:true;
    in property <string> app-version;
    in-out property <UiTheme> theme <=> Theme.palette;
    ThemeContext {}
    in property <UiPaperType> paper-type:UiPaperType.smooth;
    in property <UiPaperStyle> paper-style:UiPaperStyle.plain;
    in property <float> font-size-px:15;
    in-out property <bool> high-contrast <=> Theme.high-contrast;
    in-out property <bool> reduce-transparency <=> Theme.reduce-transparency;
    background:root.theme.paper;
    PaperSurface {width:parent.width; height:parent.height; paper-type:root.paper-type; paper-style:root.paper-style; font-size-px:root.font-size-px; }
    VerticalLayout {
        padding:Spacing.page; spacing:Spacing.lg;
        Image { source:@image-url("../assets/bulletnotes-logo.png"); height:80px; image-fit:contain; horizontal-stretch:1; }
        Text { text:"Bulletnotes"; font-size:Typography.display; font-weight:600; color:root.theme.ink; horizontal-alignment:center; }
        Text { text:root.app-version; font-size:Typography.body; color:root.theme.muted; horizontal-alignment:center; }
        AboutSlint {}
    }
}

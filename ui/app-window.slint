import { RecoveryPanel } from "recovery-view.slint";
import { ConnectionPanel } from "connection-view.slint";
import { Palette, AboutSlint } from "std-widgets.slint";
import { UiTheme, PageRow, ThemeOption, ThemePair, MarkdownCommand, MarkdownEdit } from "types.slint";
import { ActionButton } from "components/action-button.slint";
import { FindBar } from "components/find-bar.slint";
import { NoteEditor } from "components/note-editor.slint";
import { PageBrowser } from "components/page-browser.slint";
import { PaperMaterial } from "components/paper-material.slint";
import { AppearancePanel } from "components/appearance-panel.slint";
export { UiTheme, PageRow, ThemeOption, ThemePair, MarkdownCommand, MarkdownEdit }

export component AppWindow inherits Window {
    title: "Bulletnotes";
    icon: @image-url("../assets/bulletnotes-logo.png");
    preferred-width: 505px;
    preferred-height: 552px;
    min-width: 400px;
    min-height: 440px;
    background: transparent;
    no-frame: Platform.os == OperatingSystemType.macos;
    resize-border-width: 0px;
    always-on-top: root.is-pinned;
    in property <UiTheme> theme;
    in property <UiTheme> settings-theme;
    callback about-presentation-changed();
    changed settings-theme => { root.about-presentation-changed(); }
    changed prefers-reduced-transparency => { root.about-presentation-changed(); }
    callback search-palette-changed();
    changed system-high-contrast => { root.search-palette-changed(); root.about-presentation-changed(); }
    in-out property <string> active-view:"note";
    in property <string> current-path;
    in-out property <string> note-text;
    pure callback edit-markdown(string, int, int, MarkdownCommand, int, int) -> MarkdownEdit;
    out property <int> editor-anchor: editor.selection-anchor;
    out property <int> editor-caret: editor.selection-caret;
    pure callback mark-markdown(string, UiTheme) -> [TextInputMarker];
    private property <[TextInputMarker]> note-markers: root.mark-markdown(root.note-text,root.theme);
    pure callback highlight-markdown(string, UiTheme, bool) -> [TextInputDecoration];
    private property <[TextInputDecoration]> note-decorations: root.highlight-markdown(root.note-text,root.theme,root.system-high-contrast);
    in property <string> status-text;
    in-out property <bool> is-pinned:false;
    in-out property <bool> header-hovered:false;
    in-out property <bool> footer-hovered:false;
    in-out property <bool> chrome-active:true;
    out property <bool> header-revealed:false;
    out property <bool> footer-revealed:false;
    out property <float> header-opacity:header.opacity;
    out property <float> footer-opacity:footer.opacity;
    out property <length> editor-height:editor.height;
    out property <length> editor-width:editor.width;
    out property <bool> appearance-controls-first:appearance.controls-first;
    private property <int> pending-chrome-focus:0;
    private property <bool> header-focused:pin.has-focus || browse.has-focus || appearance-button.has-focus || new-button.has-focus;
    private property <bool> footer-focused:trash-button.has-focus || recovery-button.has-focus || newest.has-focus || back.has-focus || next.has-focus;
    private property <bool> header-needed:root.chrome-active && (root.header-hovered || root.pending-chrome-focus == 1 || root.header-focused || pin.pressed || browse.pressed || appearance-button.pressed || new-button.pressed);
    private property <bool> footer-needed:root.chrome-active && root.active-view == "note" && (root.footer-hovered || root.pending-chrome-focus == 2 || root.footer-focused || trash-button.pressed || recovery-button.pressed || newest.pressed || back.pressed || next.pressed);
    callback header-visibility-changed(bool, bool);
    changed header-needed => { if (root.header-needed) { root.header-revealed = true; } }
    changed footer-needed => { if (root.footer-needed) { root.footer-revealed = true; } }
    changed header-revealed => { root.header-visibility-changed(root.header-revealed,root.prefers-reduced-motion || !root.chrome-active); }
    Timer { interval:100ms; running:root.header-revealed && !root.header-needed; triggered => { root.header-revealed = false; } }
    Timer { interval:100ms; running:root.footer-revealed && !root.footer-needed; triggered => { root.footer-revealed = false; } }
    // Focus only after the reveal has a visible frame; Slint drops focus in hidden ancestors.
    Timer {
        interval:16ms; running:root.pending-chrome-focus != 0;
        triggered => {
            if (root.pending-chrome-focus == 1 && header.opacity > 0) { pin.focus(); root.pending-chrome-focus = 0; }
            else if (root.pending-chrome-focus == 2 && footer.opacity > 0) { trash-button.focus(); root.pending-chrome-focus = 0; }
        }
    }
    function focus-active-view() {
        if (root.active-view == "pages") { pages.focus-query(); }
        else if (root.active-view == "appearance") { appearance.focus-panel(); }
        else if (root.active-view == "recovery") { auxiliary.focus-panel(); }
        else if (root.active-view == "connection") { connection.focus-panel(); }
        else { editor.focus-editor(); }
    }
    public function reset-chrome() {
        if (root.header-focused || root.footer-focused) { root.focus-active-view(); }
        root.pending-chrome-focus = 0;
        root.chrome-active = false;
        root.header-hovered = false;
        root.footer-hovered = false;
        root.header-revealed = false;
        root.footer-revealed = false;
    }
    in property <bool> note-read-only:false;
    in property <bool> lifecycle-pending:false;
    in-out property <float> font-size-px:15;
    in-out property <string> paper-style:"plain";
    in-out property <string> appearance-mode:"system";
    in property <string> selected-theme-id;
    in property <string> selected-light-theme-id;
    in property <string> selected-dark-theme-id;
    in property <bool> system-appearance-dark:false;
    in property <[PageRow]> page-results;
    in property <bool> can-load-more-pages:false;
    callback load-more-pages();
    in property <[ThemePair]> theme-options;
    in-out property <string> search-query;
    in-out property <string> search-folder;
    in property <string> index-status;
    in property <string> note-counter;
    in property <string> note-date;
    in property <bool> can-go-older:false;
    in property <bool> can-go-newer:false;
    in property <bool> can-jump-to-newest:true;
    in property <bool> is-newest-scratchpad:false;
    in property <bool> status-attention:false;
    callback scratchpad-step(int);
    callback jump-to-newest();
    in property <string> appearance-message;
    in property <bool> low-contrast-warning:false;
    out property <float> editor-scroll-y:editor.scroll-y;
    out property <length> editor-line-height:editor.line-height;
    out property <int> primary-view-count:(note-view.visible ? 1 : 0) + (pages.visible ? 1 : 0) + (appearance.visible ? 1 : 0) + (auxiliary.visible ? 1 : 0) + (connection.visible ? 1 : 0);
    in property <[PageRow]> recovery-items;
    in-out property <string> recovery-section:"conflicts";
    in property <string> recovery-selected-id;
    in property <string> recovery-path;
    in property <string> recovery-local;
    in property <string> recovery-remote;
    in property <string> recovery-base;
    in-out property <string> recovery-merge;
    in-out property <string> recovery-destination;
    in property <string> recovery-message;
    in property <bool> recovery-selected:false;
    in property <bool> recovery-remote-deleted:false;
    in property <bool> recovery-has-base:false;
    in property <bool> recovery-writable:false;
    in property <bool> recovery-stale:false;
    in property <bool> recovery-busy:false;
    in property <bool> recovery-draft-closed:false;
    callback show-recovery();
    callback recovery-section-changed();
    callback recovery-select(string);
    callback recovery-apply(string);
    callback recovery-merge-edited();
    callback recovery-restore();
    callback recovery-purge();
    callback recovery-reload();
    callback recovery-completed(bool,string);
    callback refresh-recovery();
    callback trash-current-note();
    callback save-now();
    in-out property <bool> find-visible:false;
    in-out property <string> find-query;
    in property <string> find-status;
    callback find-opened();
    callback find-query-changed(string);
    callback find-step(int);
    public function show-find() { if (root.active-view != "note") { root.return-to-note(); } root.find-visible = true; find.focus-query(); root.find-opened(); }
    public function close-find() { root.find-visible = false; editor.focus-editor(); }
    public function select-find-match(anchor:int, caret:int) { editor.select-match(anchor,caret); }
    callback native-window-ready();
    callback native-preferences-changed();
    callback native-activation-changed();
    callback native-reopen-requested();
    callback export-diagnostics();
    callback show-about();
    callback native-geometry-changed();
    callback native-displays-changed();
    callback toggle-activation();
    public function focus-recovery-merge() { auxiliary.focus-merge(); }
    callback window-will-hide();
    in-out property <string> hotkey-accelerator:"Option+A";
    in property <string> native-message;
    in property <bool> native-warning:false;
    in property <bool> hotkey-busy:false;
    in property <bool> can-hide-to-tray:true;
    property <string> shortcut-modifier:Platform.os == OperatingSystemType.macos ? "Command" : "Control";
    callback apply-hotkey();
    in property <bool> prefers-reduced-motion:false;
    in property <bool> prefers-reduced-transparency:false;
    in property <bool> system-high-contrast:false;
    private property <UiTheme> chrome-theme:root.active-view == "appearance" || root.active-view == "connection" ? root.settings-theme : root.theme;
    private property <bool> decorative-effects:!root.system-high-contrast && !root.prefers-reduced-transparency;
    callback local-startup-ready();
    in property <bool> sync-available:false;
    callback request-quit();
    callback request-hide();
    callback browse-pages();
    callback open-page(string);
    callback new-note();
    callback show-appearance();
    callback show-connection();
    callback test-connection();
    in-out property <string> connection-url;
    in-out property <string> connection-token;
    in-out property <bool> connection-remember:false;
    in property <bool> connection-busy:false;
    in property <string> connection-message;
    callback return-to-note();
    callback note-edited(string);
    callback appearance-changed();
    callback theme-selected(string);
    callback theme-assigned(string, bool);
    callback import-theme();
    callback export-theme();
    callback query-changed(string);
    callback folder-changed(string);
    callback toggle-pin();
    callback apply-low-contrast();
    callback cancel-theme-import();
    public function focus-editor() { editor.focus-editor(); }
    public function restore-editor-position(anchor: int, caret: int, y: float) { editor.restore-selection(anchor,caret,y); }
    public function reveal-theme-choices() { appearance.reveal-themes(); }
    function shortcut(event: KeyEvent) -> EventResult {
        if (event.text == Key.F6) {
            root.chrome-active = true;
            if ((root.header-focused || root.pending-chrome-focus == 1) && root.active-view == "note") {
                root.pending-chrome-focus = 2; root.footer-revealed = true;
            } else if (root.header-focused || root.footer-focused || root.pending-chrome-focus != 0) {
                root.pending-chrome-focus = 0; root.focus-active-view();
            } else { root.pending-chrome-focus = 1; root.header-revealed = true; }
            return accept;
        }
        if (event.text == Key.Escape && (root.header-focused || root.footer-focused || root.pending-chrome-focus != 0)) {
            root.pending-chrome-focus = 0; root.focus-active-view();
            return accept;
        }
        // Slint maps the macOS Command key to control.
        if (event.modifiers.control) {
            if (event.text == "f" || event.text == "F") { root.show-find(); return accept; }
            if ((event.text == "g" || event.text == "G") && root.active-view == "note") { root.find-step(event.modifiers.shift ? -1 : 1); return accept; }
            if (event.text == "q" || event.text == "Q") { root.request-quit(); return accept; }
            if (event.text == "w" || event.text == "W") { root.request-hide(); return accept; }
            if (event.text == "s" || event.text == "S") { root.save-now(); return accept; }
            if (!event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && (event.text == "k" || event.text == "K")) { root.browse-pages(); return accept; }
            if (event.text == "1") { if (root.can-jump-to-newest) {root.jump-to-newest();} return accept; }
            if (event.text == "p" || event.text == "P") {root.toggle-pin();return accept;}
            if (event.text == "n" || event.text == "N") { root.new-note(); return accept; }
            if (event.text == ",") { root.show-appearance(); return accept; }
            if (event.text == "[") { root.scratchpad-step(-1); return accept; }
            if (event.text == "]") { root.scratchpad-step(1); return accept; }
        }
        if (event.text == Key.Escape && root.active-view == "note" && root.find-visible) { root.close-find(); return accept; }
        if (event.text == Key.Escape && root.active-view == "pages" && !pages.escape-allowed) { return reject; }
        if (event.text == Key.Escape && root.active-view != "note") {
            if (root.low-contrast-warning) { root.cancel-theme-import(); } else { root.return-to-note(); }
            return accept;
        }
        return reject;
    }
    init => { Palette.color-scheme = root.chrome-theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed theme => { root.search-palette-changed(); }
    changed chrome-theme => { Palette.color-scheme = root.chrome-theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed active-view => {
        if (root.active-view == "pages") { pages.focus-query(); }
        else if (root.active-view == "appearance") { appearance.focus-panel(); }
        else if (root.active-view == "recovery") { auxiliary.focus-panel(); }
        else if (root.active-view == "connection") { connection.focus-panel(); }
        else if (root.active-view == "note") { editor.focus-editor(); }
        if (root.active-view != "connection") { root.connection-token = ""; }
    }
    Rectangle {
        background: root.active-view == "appearance" || root.active-view == "connection" ? root.settings-theme.paper : root.theme.paper;
        border-radius: 16px;
        clip: true;
        keys := FocusScope {
            key-pressed(event) => { root.shortcut(event) }
            capture-key-pressed(event) => {
                if (event.text == Key.F6 || (event.text == Key.Escape && (root.header-focused || root.footer-focused || root.pending-chrome-focus != 0 || (root.active-view == "pages" && pages.escape-allowed)))) { return root.shortcut(event); }
                return reject;
            }
            // Retain the editor instance while other views are shown, preserving its native editing state.
            note-view := Rectangle {
                height: parent.height;
                width: parent.width;
                visible: root.active-view != "pages" && root.active-view != "appearance" && root.active-view != "connection" && root.active-view != "recovery";
                editor := NoteEditor {
                    width: parent.width;
                    height: parent.height;
                    top-clearance:root.find-visible ? 93.75px : 33.75px;
                    theme: root.theme;
                    paper-material:root.decorative-effects && (root.selected-theme-id == "bulletnotes" || root.selected-theme-id == "bulletnotes-dark");
                    text <=> root.note-text;
                    decorations: root.note-decorations;
                    markers: root.note-markers;
                    font-size-px: root.font-size-px;
                    paper-style: root.paper-style;
                    read-only: root.note-read-only || root.recovery-busy || root.lifecycle-pending;
                    edit-markdown(source,anchor,caret,command,start,end) => { root.edit-markdown(source,anchor,caret,command,start,end) }
                    edited(text) => { root.note-edited(text); }
                    move-to-trash => { root.trash-current-note(); }
                    key-pressed(event) => { root.shortcut(event) }
                }

                find := FindBar {
                high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                    y: 48px; height: 36px; width: parent.width;
                    visible: root.find-visible;
                    theme: root.theme; query <=> root.find-query; status: root.find-status;
                    query-changed(query) => { root.find-query-changed(query); }
                    step(direction) => { root.find-step(direction); }
                    close => { root.close-find(); }
                }

            }

            pages := PageBrowser {
                high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                y: 44px;
                height: parent.height - 44px;
                width: parent.width;
                visible: root.active-view == "pages";
                theme: root.theme;
                results: root.page-results;
        can-load-more:root.can-load-more-pages;
        load-more => { root.load-more-pages(); }
                query <=> root.search-query;
                folder <=> root.search-folder;
                folder-changed(folder) => { root.folder-changed(folder); }
                index-status: root.index-status;
                query-changed(query) => { root.query-changed(query); }
                open-page(key) => { root.open-page(key); }
                return-to-note => { root.return-to-note(); }
            }

            appearance := AppearancePanel {
                y: 44px;
                height: parent.height - 44px;
                width: parent.width;
                visible: root.active-view == "appearance";
                theme-pairs: root.theme-options;
                light-theme: root.selected-light-theme-id;
                dark-theme: root.selected-dark-theme-id;
                chrome: root.settings-theme;
                high-contrast: root.system-high-contrast;
                material-effects:root.decorative-effects;
                mode <=> root.appearance-mode;
                paper-style <=> root.paper-style;
                font-size-px <=> root.font-size-px;
                message: root.appearance-message;
                low-contrast-warning: root.low-contrast-warning;
                hotkey-accelerator <=> root.hotkey-accelerator; native-message:root.native-message; hotkey-busy:root.hotkey-busy;
                apply-hotkey => { root.apply-hotkey(); }
                changed => { root.appearance-changed(); }
                theme-selected(id) => { root.theme-selected(id); }
                theme-assigned(id,dark) => { root.theme-assigned(id,dark); }
                import-theme => { root.import-theme(); }
                export-theme => { root.export-theme(); }
                return-to-note => { root.return-to-note(); }
                show-connection => { root.show-connection(); }
                apply-low-contrast => { root.apply-low-contrast(); }
                cancel-theme-import => { root.cancel-theme-import(); }
            }

            connection := ConnectionPanel {
                high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                y:44px; height:parent.height - 44px; width:parent.width;
                visible:root.active-view == "connection";
                theme:root.settings-theme; server-url <=> root.connection-url;
                token <=> root.connection-token; remember <=> root.connection-remember;
                busy:root.connection-busy || root.lifecycle-pending; message:root.connection-message; automatic-mode:root.sync-available;
                test-connection => { root.test-connection(); }
                return-to-note => { root.return-to-note(); }
            }
            auxiliary := RecoveryPanel {
                high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                y:44px; height:parent.height - 44px; width:parent.width;
                visible:root.active-view == "recovery";
                theme:root.theme; section <=> root.recovery-section; items:root.recovery-items;
                selected-id:root.recovery-selected-id; path:root.recovery-path;
                local-text:root.recovery-local; remote-text:root.recovery-remote; base-text:root.recovery-base;
                merge-text <=> root.recovery-merge; destination <=> root.recovery-destination;
                selected:root.recovery-selected; remote-deleted:root.recovery-remote-deleted;
                has-base:root.recovery-has-base; writable:root.recovery-writable;
                stale:root.recovery-stale; draft-closed:root.recovery-draft-closed; busy:root.recovery-busy || root.lifecycle-pending; message:root.recovery-message;
                return-to-note => { root.return-to-note(); }
                section-changed => { root.recovery-section-changed(); }
                select-item(id) => { root.recovery-select(id); }
                apply-choice(choice) => { root.recovery-apply(choice); }
                merge-edited => { root.recovery-merge-edited(); }
                restore-item => { root.recovery-restore(); }
                purge-item => { root.recovery-purge(); }
                reload => { root.recovery-reload(); }
            }
            Rectangle {
                x:parent.width - 20px; y:parent.height - 22px;
                width:4px; height:4px; border-radius:2px;
                background:root.theme.accent;
                visible:root.active-view == "note" && root.is-newest-scratchpad && !root.footer-revealed;
                accessible-role:text; accessible-label:"Newest scratchpad";
            }
            Rectangle {
                x:20px; width:parent.width - 40px; height:48px; y:parent.height - 112px;
                visible:root.status-attention && root.active-view == "note";
                background:root.theme.surface; border-radius:10px; border-width:1px; border-color:root.theme.accent;
                Text {x:12px; width:parent.width - 24px; height:parent.height; text:root.status-text; color:root.theme.ink; font-size:11px; wrap:word-wrap; vertical-alignment:center;}
            }
            header := Rectangle {
                x:0px; y:root.prefers-reduced-motion || root.header-revealed ? 0px : -4px;
                width:parent.width; height:44px;
                background:root.chrome-theme.paper;
                border-width:root.system-high-contrast ? 1px : 0px; border-color:root.chrome-theme.line;
                opacity:root.header-revealed ? 1 : 0;
                visible:self.opacity > 0;
                animate opacity, y { duration:root.prefers-reduced-motion || !root.chrome-active ? 0ms : (root.header-revealed ? 160ms : 200ms); easing:ease-out; }
                WindowMoveArea {x:160px; width:max(0px,parent.width - 248px); height:parent.height; enabled:root.header-revealed;}
                appearance-button := ActionButton {
                    x:82px; y:6px; circular:true; theme:root.chrome-theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                    enabled:root.header-revealed && header.opacity > 0;
                    icon:@image-url("../assets/icons/appearance.svg"); label:"Settings, " + root.shortcut-modifier + " comma";
                    clicked => {root.show-appearance();}
                }
                browse := ActionButton {
                    x:120px; y:6px; circular:true; theme:root.chrome-theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                    enabled:root.header-revealed && header.opacity > 0;
                    icon:@image-url("../assets/icons/search.svg"); label:"Search all pages, " + root.shortcut-modifier + " K";
                    clicked => {root.browse-pages();}
                }
                Text {
                    x:164px; width:max(0px,parent.width - 252px); height:parent.height;
                    text:root.active-view == "note" ? root.current-path : "Bulletnotes";
                    accessible-label:root.current-path;
                    color:root.chrome-theme.muted; font-size:11px; overflow:elide;
                    horizontal-alignment:center; vertical-alignment:center;
                }
                new-button := ActionButton {
                    x:parent.width - 82px; y:6px; circular:true; theme:root.chrome-theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                    enabled:root.header-revealed && header.opacity > 0 && !root.lifecycle-pending;
                    icon:@image-url("../assets/icons/plus.svg"); label:"New scratchpad, " + root.shortcut-modifier + " N";
                    clicked => {root.new-note();}
                }
                pin := ActionButton {
                    x:parent.width - 42px; y:6px; circular:true; theme:root.chrome-theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                    enabled:root.header-revealed && header.opacity > 0;
                    icon:@image-url("../assets/icons/pin.svg");
                    label:root.is-pinned ? "Unpin note, " + root.shortcut-modifier + " P" : "Pin above other windows, " + root.shortcut-modifier + " P";
                    selected:root.is-pinned; clicked => {root.toggle-pin();}
                }
            }
            footer := Rectangle {
                y:parent.height - 54px + (root.prefers-reduced-motion || root.footer-revealed ? 0px : 4px);
                height:44px; x:10px; width:parent.width - 20px; border-radius:22px;
                border-width:1px; border-color:root.theme.line.with-alpha(root.system-high-contrast ? 1 : 0.25);
                opacity:root.footer-revealed ? 1 : 0; visible:self.opacity > 0 && root.active-view == "note";
                animate opacity, y {duration:root.prefers-reduced-motion || !root.chrome-active ? 0ms : (root.footer-revealed ? 160ms : 200ms); easing:ease-out;}
                background:root.theme.surface;
                HorizontalLayout {
                    y:6px; width:parent.width; height:32px; padding-left:6px; padding-right:6px; spacing:6px;
                    trash-button := ActionButton {
                        circular:true; theme:root.theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects;
                        enabled:root.footer-revealed && footer.opacity > 0 && !root.note-read-only && !root.recovery-busy && !root.lifecycle-pending;
                        icon:@image-url("../assets/icons/trash.svg"); label:"Move note to recoverable Trash";
                        clicked => {root.trash-current-note();}
                    }
                    VerticalLayout {
                        horizontal-stretch:1; spacing:0px;
                        Text {text:root.note-counter.is-empty ? root.note-date : (root.note-date.is-empty ? root.note-counter : root.note-date + " · " + root.note-counter); color:root.theme.muted; font-size:11px; vertical-alignment:center; overflow:elide;}
                        Text {text:root.status-text; color:root.theme.muted; font-size:11px; vertical-alignment:center; overflow:elide;}
                    }
                    back := ActionButton {
                        circular:true; theme:root.theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects; icon:@image-url("../assets/icons/left.svg"); label:"Older scratchpad, " + root.shortcut-modifier + " left bracket";
                        enabled:root.footer-revealed && footer.opacity > 0 && root.can-go-older && !root.lifecycle-pending;
                        clicked => {root.scratchpad-step(-1);}
                    }
                    next := ActionButton {
                        circular:true; theme:root.theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects; icon:@image-url("../assets/icons/right.svg"); label:"Newer scratchpad, " + root.shortcut-modifier + " right bracket";
                        enabled:root.footer-revealed && footer.opacity > 0 && root.can-go-newer && !root.lifecycle-pending;
                        clicked => {root.scratchpad-step(1);}
                    }
                    newest := ActionButton {
                        circular:true; theme:root.theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects; icon:@image-url("../assets/icons/newest.svg"); label:"Jump to newest scratchpad, " + root.shortcut-modifier + " 1";
                        enabled:root.footer-revealed && footer.opacity > 0 && root.can-jump-to-newest && !root.lifecycle-pending;
                        clicked => {root.jump-to-newest();}
                    }
                    recovery-button := ActionButton {
                        circular:true; theme:root.theme; high-contrast:root.system-high-contrast; material-effects:root.decorative-effects; icon:@image-url("../assets/icons/recovery.svg"); label:"Changes, Trash, and kept versions";
                        enabled:root.footer-revealed && footer.opacity > 0;
                        clicked => {root.show-recovery();}
                    }
                }
            }

        }
    }
}

export component LocalTray inherits SystemTrayIcon {
    icon: @image-url("../assets/native-preview-tray.svg");
    title: "BN";
    tooltip: "Bulletnotes";
    callback reopen();
    callback quit();
    callback show-about();
    callback export-diagnostics();
    Menu {
        MenuItem { title: "About Bulletnotes"; activated => { root.show-about(); } }
        MenuSeparator {}
        MenuItem { title: "Export diagnostics…"; activated => { root.export-diagnostics(); } }
        MenuItem { title: "Show Bulletnotes"; activated => { root.reopen(); } }
        MenuSeparator {}
        MenuItem { title: "Quit Bulletnotes"; activated => { root.quit(); } }
    }
}

export component AboutWindow inherits Window {
    title:"About Bulletnotes";
    icon:@image-url("../assets/bulletnotes-logo.png");
    preferred-width:360px; preferred-height:300px;
    min-width:360px; min-height:300px;
    always-on-top:true;
    in property <string> app-version;
    in property <UiTheme> theme;
    in property <bool> high-contrast:false;
    in property <bool> reduce-transparency:false;
    background:root.theme.paper;
    init => { Palette.color-scheme = root.theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed theme => { Palette.color-scheme = root.theme.dark ? ColorScheme.dark : ColorScheme.light; }
    PaperMaterial { width:parent.width; height:parent.height; active:!root.high-contrast && !root.reduce-transparency; tint:root.theme.ink; strength:root.theme.dark ? 0.015 : 0.005; }
    VerticalLayout {
        padding:24px; spacing:12px;
        Image { source:@image-url("../assets/bulletnotes-logo.png"); height:80px; image-fit:contain; horizontal-stretch:1; }
        Text { text:"Bulletnotes"; font-size:24px; font-weight:600; color:root.theme.ink; horizontal-alignment:center; }
        Text { text:root.app-version; font-size:13px; color:root.theme.muted; horizontal-alignment:center; }
        AboutSlint {}
    }
}

import { Theme, Typography, Radius } from "theme.slint";
import { ActionButton } from "action-button.slint";
export component FindBar inherits Rectangle {
    in-out property <string> query;
    in property <string> status;
    callback query-changed(string);
    callback step(int);
    callback close();
    public function focus-query() { query-input.focus(); }
    background: Theme.palette.paper;
    HorizontalLayout {
        padding-left: 26px; padding-right: 10px;
        padding-top: 3px; padding-bottom: 3px; spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: Radius.card;
            background: Theme.palette.surface;
            border-width: 1px;
            border-color: query-input.has-focus ? Theme.palette.accent : Theme.palette.line;
            query-input := TextInput {
                x: 8px; width: parent.width - 16px; height: parent.height;
                vertical-alignment: center; single-line: true;
                text <=> root.query;
                color: Theme.palette.ink; font-size: Typography.small;
                selection-background-color: Theme.palette.cursor;
                selection-foreground-color: Theme.palette.ink;
                input-method-hints: { capitalization:none, auto-correct:false, auto-complete:false };
                accessible-label: "Find in note, case sensitive";
                edited => { root.query-changed(self.text); }
                key-pressed(event) => {
                    if (event.text == Key.Return) { root.step(event.modifiers.shift ? -1 : 1); return accept; }
                    if (event.text == Key.Escape) { root.close(); return accept; }
                    return reject;
                }
            }
            Text {
                x: 8px; width: parent.width - 16px; height: parent.height;
                text: "Find · match case"; visible: root.query == "";
                vertical-alignment: center; font-size: Typography.small; color: Theme.palette.muted;
                accessible-role: none;
            }
        }
        Text { width: 66px; text: root.status; color: Theme.palette.muted; font-size: Typography.caption; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
        ActionButton { icon: @image-url("../../assets/icons/left.svg"); label: "Previous match, Shift Enter"; clicked => { root.step(-1); } }
        ActionButton { icon: @image-url("../../assets/icons/right.svg"); label: "Next match, Enter"; clicked => { root.step(1); } }
        ActionButton { icon: @image-url("../../assets/icons/close.svg"); label: "Close find, Escape"; clicked => { root.close(); } }
    }
}

import { Theme, Typography, Radius, Spacing } from "theme.slint";
import { ActionOption, ChoiceButton } from "action-button.slint";

export component SearchToolbar inherits Rectangle {
    in property <bool> enabled:true;
    in property <bool> scratchpads;
    in property <bool> cards;
    in property <bool> selecting;
    in property <int> selected-count;
    in property <bool> can-promote;
    in property <bool> can-trash;
    in property <bool> busy;
    callback select-toggled();
    callback scope-changed();
    callback view-changed(bool);
    callback promote-selected();
    callback trash-selected();
    height:root.selecting ? 98px : 54px;
    background:Theme.palette.paper;
    if root.selecting: Rectangle {
        x:Spacing.page;y:0px;width:parent.width - 2 * Spacing.page;height:38px;border-radius:Radius.group;background:Theme.palette.surface;
        Text { x:10px; width:66px;height:parent.height; text:root.selected-count + " selected";font-size:Typography.caption;color:Theme.palette.muted;vertical-alignment:center; }
        ChoiceButton { height:28px; x:76px;y:4px;width:112px;text:"Promote selected";visible:root.scratchpads;enabled:root.enabled && root.can-promote && !root.busy;clicked => { root.promote-selected(); } }
        ChoiceButton { height:28px; x:parent.width - 140px;y:4px;width:132px;text:"Move selected to Trash";enabled:root.enabled && root.can-trash && !root.busy;clicked => { root.trash-selected(); } }
    }
    Rectangle {
        x:Spacing.page;y:root.selecting ? 44px : 0px;width:78px;height:38px;border-radius:self.height / 2;background:transparent;
        ChoiceButton { height:28px; x:0px;y:5px;width:parent.width;text:root.selecting ? "Done" : "Select";selected:root.selecting;enabled:root.enabled && !root.busy;clicked => { root.select-toggled(); } }
    }
    Rectangle {
        x:110px;y:root.selecting ? 44px : 0px;width:128px;height:38px;border-radius:self.height / 2;background:transparent;
        ChoiceButton { height:28px; x:0px;y:5px;width:parent.width;text:root.scratchpads ? "Scratchpads" : "All Pages";label:"Switch between Scratchpads and All Pages";enabled:root.enabled && !root.busy;clicked => { root.scope-changed(); } }
    }
    Rectangle {
        x:parent.width - 92px;y:root.selecting ? 44px : 0px;width:68px;height:38px;border-radius:self.height / 2;background:transparent;
        ActionOption { x:0px;y:5px;icon:@image-url("../../assets/icons/list.svg");label:"List view";enabled:root.enabled;selected:!root.cards;clicked => { root.view-changed(false); } }
        ActionOption { x:40px;y:5px;icon:@image-url("../../assets/icons/grid.svg");label:"Card view";enabled:root.enabled;selected:root.cards;clicked => { root.view-changed(true); } }
    }
}

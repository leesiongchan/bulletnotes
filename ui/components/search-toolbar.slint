import { UiTheme } from "../types.slint";
import { ActionButton, ChoiceButton } from "action-button.slint";

export component SearchToolbar inherits Rectangle {
    in property <UiTheme> theme;
    in property <bool> high-contrast:false;
    in property <bool> material-effects:true;
    in property <bool> enabled:true;
    in property <bool> scratchpads;
    in property <bool> cards;
    in property <bool> selecting;
    in property <int> selected-count;
    in property <bool> can-promote;
    in property <bool> can-trash;
    in property <bool> busy;
    callback select-toggled();
    callback scope-changed();
    callback view-changed(bool);
    callback promote-selected();
    callback trash-selected();
    height:root.selecting ? 98px : 54px;
    background:root.theme.paper;
    if root.selecting: Rectangle {
        x:24px;y:0px;width:parent.width - 48px;height:38px;border-radius:10px;background:root.theme.surface;
        Text { x:10px; width:66px;height:parent.height; text:root.selected-count + " selected";font-size:11px;color:root.theme.muted;vertical-alignment:center; }
        ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:76px;y:4px;width:112px;theme:root.theme;text:"Promote selected";visible:root.scratchpads;enabled:root.enabled && root.can-promote && !root.busy;clicked => { root.promote-selected(); } }
        ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:parent.width - 140px;y:4px;width:132px;theme:root.theme;text:"Move selected to Trash";enabled:root.enabled && root.can-trash && !root.busy;clicked => { root.trash-selected(); } }
    }
    Rectangle {
        x:24px;y:root.selecting ? 44px : 0px;width:78px;height:38px;border-radius:19px;background:transparent;
        ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:0px;y:5px;width:parent.width;theme:root.theme;text:root.selecting ? "Done" : "Select";selected:root.selecting;enabled:root.enabled && !root.busy;clicked => { root.select-toggled(); } }
    }
    Rectangle {
        x:110px;y:root.selecting ? 44px : 0px;width:128px;height:38px;border-radius:19px;background:transparent;
        ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:0px;y:5px;width:parent.width;theme:root.theme;text:root.scratchpads ? "Scratchpads" : "All Pages";label:"Switch between Scratchpads and All Pages";enabled:root.enabled && !root.busy;clicked => { root.scope-changed(); } }
    }
    Rectangle {
        x:parent.width - 92px;y:root.selecting ? 44px : 0px;width:68px;height:38px;border-radius:19px;background:transparent;
        ActionButton { high-contrast:root.high-contrast; material-effects:root.material-effects; x:0px;y:5px;theme:root.theme;icon:@image-url("../../assets/icons/list.svg");label:"List view";enabled:root.enabled;selected:!root.cards;clicked => { root.view-changed(false); } }
        ActionButton { high-contrast:root.high-contrast; material-effects:root.material-effects; x:40px;y:5px;theme:root.theme;icon:@image-url("../../assets/icons/grid.svg");label:"Card view";enabled:root.enabled;selected:root.cards;clicked => { root.view-changed(true); } }
    }
}

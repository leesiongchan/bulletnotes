import { ListView } from "std-widgets.slint";
import { ThemeScrollbar } from "theme-scrollbar.slint";
import { UiTheme, PageRow } from "../types.slint";
import { ChoiceButton } from "action-button.slint";
import { SearchResult } from "search-result.slint";
import { SearchToolbar } from "search-toolbar.slint";

export component PageBrowser inherits Rectangle {
    in property <UiTheme> theme;
    in property <bool> high-contrast:false;
    in property <bool> material-effects:true;
    in property <[PageRow]> results;
    in-out property <string> query;
    in-out property <string> folder;
    in-out property <bool> scratchpads;
    in-out property <bool> cards;
    in-out property <bool> selecting;
    in property <int> selected-count;
    in property <bool> busy;
    in property <int> confirm-count;
    in property <string> confirm-id;
    in property <string> action-message;
    in property <bool> can-promote;
    in property <bool> can-trash;
    in property <bool> can-create;
    in property <bool> can-reorder;
    in-out property <bool> drag-active;
    private property <length> drag-x;
    private property <length> drag-y;
    private property <int> drag-index;
    private property <bool> drag-after;
    private property <length> edge-step:!root.drag-active ? 0px : root.drag-y < 24px ? 8px : root.drag-y > list.visible-height - 24px ? -8px : 0px;
    callback drag-started(string);
    callback drag-cancelled();
    callback reordered(string,bool);
    in property <string> index-status;
    in property <bool> can-load-more:false;
    in-out property <int> selected-index:-1;
    private property <int> columns:root.cards ? max(1,floor((root.width - 32px) / 236px)) : 1;
    private property <length> row-height:root.cards ? min(236px,max(160px,list.visible-height)) : 112px;
    private property <int> row-count:ceil(root.results.length / root.columns);
    out property <bool> escape-allowed: query-input.has-focus ? query-input.source-edits-allowed : (folder-input.has-focus ? folder-input.source-edits-allowed : true);
    callback load-more();
    callback query-changed(string);
    callback folder-changed(string);
    callback open-page(string);
    callback return-to-note();
    callback scope-changed(bool);
    callback view-changed(bool);
    callback select-toggled();
    callback selection-toggled(string);
    callback promote(string,bool);
    callback promote-selected();
    callback trash(string);
    callback trash-selected();
    callback trash-confirmed(string);
    callback trash-cancelled();
    callback create();
    public function focus-query() { root.selected-index = -1; query-input.focus(); }
    pure function pointer-index(x:length,y:length) -> int {
        let index = floor((y - list.content-y) / root.row-height) * root.columns + floor(x / (list.width / root.columns));
        return x >= 0px && x < list.width && y >= 0px && y < list.visible-height && index < root.results.length ? index : -1;
    }
    pure function pointer-action(x:length,y:length) -> int {
        let local-x = mod(x,list.width / root.columns) - 4px;
        let local-y = mod(y - list.content-y,root.row-height) - 3px;
        let cell-width = list.width / root.columns - 8px;
        let button-y = root.cards ? root.row-height - 33px : 27px;
        if (local-y >= button-y && local-y < button-y + 28px) {
            if (local-x >= cell-width - 42px && local-x < cell-width - 14px) { return 3; }
            if (local-x >= cell-width - 76px && local-x < cell-width - 48px) { return 2; }
        }
        return root.selecting && local-x >= 8px && local-x < 36px && local-y >= 10px && local-y < 38px ? 1 : 0;
    }
    function cancel-drag() { if (root.drag-active) { root.drag-active = false; root.drag-cancelled(); } }
    function update-drag(x:length,y:length) {
        if (!root.drag-active || root.results.length == 0) { return; }
        root.drag-x = x; root.drag-y = y;
        root.drag-index = max(0,min(root.results.length - 1,floor((y - list.content-y) / root.row-height) * root.columns + floor(clamp(x,0px,list.width - 1px) / (list.width / root.columns))));
        root.drag-after = root.cards ? x - floor(x / (list.width / root.columns)) * (list.width / root.columns) > list.width / root.columns / 2 : y - list.content-y - floor((y - list.content-y) / root.row-height) * root.row-height > root.row-height / 2;
    }
    function drop-drag() {
        if (!root.drag-active) { return; }
        if (root.drag-y < 0px || root.drag-y > list.visible-height || root.drag-x < 0px || root.drag-x > list.width) { root.cancel-drag(); return; }
        root.drag-active = false;
        root.reordered(root.results[root.drag-index].key,root.drag-after);
    }
    Timer {
        interval:16ms;running:root.drag-active && root.edge-step != 0px;
        triggered => { list.content-y = clamp(list.content-y + root.edge-step,min(0px,list.visible-height - list.content-height),0px); root.update-drag(root.drag-x,root.drag-y); }
    }
    public function cancel-or-close() {
        if (root.drag-active) { root.cancel-drag(); return; }
        if (root.confirm-count > 0) { root.trash-cancelled(); query-input.focus(); }
        else if (root.selecting) { root.selecting = false; root.select-toggled(); query-input.focus(); }
        else { root.query = ""; root.return-to-note(); }
    }
    function reveal-selection() {
        if (root.selected-index < 0) { return; }
        if (floor(root.selected-index / root.columns) * root.row-height < -list.content-y) {
            list.content-y = -floor(root.selected-index / root.columns) * root.row-height;
        } else if ((floor(root.selected-index / root.columns) + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = min(0px,list.visible-height - (floor(root.selected-index / root.columns) + 1) * root.row-height);
        }
    }
    function move-selection(step:int) {
        if (root.results.length > 0) {
            root.selected-index = max(0,min(root.results.length - 1,root.selected-index < 0 ? 0 : root.selected-index + step));
            root.reveal-selection();
        }
    }
    changed results => {
        pointer-surface.source-index = -1;
        root.cancel-drag();
        if (root.selected-index >= root.results.length) { root.focus-query(); }
    }
    changed query => { pointer-surface.source-index = -1; root.cancel-drag(); root.selected-index = -1; list.content-y = 0px; }
    changed scratchpads => { pointer-surface.source-index = -1; root.cancel-drag(); root.selected-index = -1; list.content-y = 0px; }
    changed folder => { pointer-surface.source-index = -1; root.cancel-drag(); root.selected-index = -1; list.content-y = 0px; }
    changed cards => { pointer-surface.source-index = -1; root.cancel-drag(); root.reveal-selection(); }
    changed height => { root.cancel-drag(); root.reveal-selection(); }
    changed width => { root.cancel-drag(); root.reveal-selection(); }
    changed visible => { if (!root.visible) { root.cancel-drag(); } }
    changed confirm-id => { if (root.confirm-count > 0) { confirm-button.focus(); } }
    background:root.theme.paper;
    Rectangle {
        x:24px;y:14px;width:parent.width - 48px;height:38px;border-radius:12px;
        background:root.theme.surface;border-width:query-input.has-focus ? 1px : 0px;border-color:root.theme.accent;
        Image { x:12px;y:12px;width:14px;height:14px;source:@image-url("../../assets/icons/search.svg");colorize:root.theme.muted; }
        query-input := TextInput {
            x:36px;width:parent.width - 78px;height:parent.height;single-line:true;vertical-alignment:center;
            text <=> root.query;color:root.theme.ink;font-size:13px;enabled:root.confirm-count == 0;
            selection-background-color:root.theme.cursor;selection-foreground-color:root.theme.ink;
            accessible-label:"Search notes";
            edited => { root.query-changed(self.text); }
            key-pressed(event) => {
                if (!self.source-edits-allowed || root.busy) { return reject; }
                if (event.text == Key.DownArrow && root.results.length > 0) { root.move-selection(1); return accept; }
                if (event.text == Key.Return) {
                    if (root.results.length > 0) {
                        if (event.modifiers.shift && root.scratchpads) { root.promote(root.results[max(0,root.selected-index)].key,true); }
                        else if (!event.modifiers.shift) { root.open-page(root.results[max(0,root.selected-index)].key); }
                    } else if (root.can-create && !event.modifiers.shift) { root.create(); }
                    return accept;
                }
                return reject;
            }
        }
        Text { x:36px;width:parent.width - 78px;height:parent.height;vertical-alignment:center;text:"Search";visible:root.query == "";color:root.theme.muted;font-size:13px;accessible-role:none; }
        ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:parent.width - 39px;y:5px;width:34px;theme:root.theme;text:"esc";label:"Return to note";clicked => { root.cancel-or-close(); } }
    }
    Rectangle {
        x:24px;y:60px;width:parent.width - 48px;height:28px;border-radius:8px;background:root.theme.surface;visible:!root.scratchpads;
        border-width:folder-input.has-focus ? 1px : 0px;border-color:root.theme.accent;
        Text { x:10px;width:44px;height:parent.height;text:"Folder";font-size:13px;color:root.theme.muted;vertical-alignment:center; }
        folder-input := TextInput {
            x:60px;width:parent.width - 70px;height:parent.height;single-line:true;vertical-alignment:center;
            text <=> root.folder;color:root.theme.ink;font-size:13px;enabled:root.confirm-count == 0;
            selection-background-color:root.theme.cursor;selection-foreground-color:root.theme.ink;
            accessible-label:"Filter by folder, empty for all folders";
            edited => { root.folder-changed(self.text); }
        }
        Text { x:60px;width:parent.width - 70px;height:parent.height;vertical-alignment:center;text:"All folders";visible:root.folder == "";font-size:13px;color:root.theme.muted;accessible-role:none; }
    }
    list := ListView {
        x:12px;y:root.scratchpads ? 64px : 98px;width:parent.width - 24px;
        height:max(0px,parent.height - self.y - toolbar.height - 38px);
        vertical-scrollbar-policy:always-off;enabled:root.confirm-count == 0;
        for row in root.row-count: Rectangle {
            width:parent.width;height:root.row-height;
            for col in root.columns: SearchResult {
                high-contrast:root.high-contrast;material-effects:root.material-effects;
                x:col * parent.width / root.columns;width:parent.width / root.columns;height:root.row-height;
                visible:row * root.columns + col < root.results.length;
                theme:root.theme;data:root.results[row * root.columns + col];cards:root.cards;columns:root.columns;
                selected:root.selected-index == row * root.columns + col;
                selecting:root.selecting;busy:root.busy;
                hovered:pointer-surface.has-hover && row * root.columns + col == root.pointer-index(pointer-surface.mouse-x,pointer-surface.mouse-y);
                opened => { root.open-page(root.results[row * root.columns + col].key); }
                toggled => { root.selection-toggled(root.results[row * root.columns + col].key); }
                promote(open) => { root.promote(root.results[row * root.columns + col].key,open); }
                trash => { root.trash(root.results[row * root.columns + col].key); }
                step(amount) => { root.selected-index = row * root.columns + col; root.move-selection(amount); }
            }
        }
    }
    // Keep the pointer owner outside virtualized rows while edge scrolling replaces them.
    pointer-surface := TouchArea {
        x:list.x;y:list.y;width:list.width;height:list.visible-height;
        enabled:!root.busy && root.confirm-count == 0;
        private property <int> source-index:-1;
        private property <int> action:0;
        private property <bool> dragged:false;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.source-index = root.pointer-index(self.mouse-x,self.mouse-y);
                self.action = root.pointer-action(self.mouse-x,self.mouse-y);
                self.dragged = false;
            }
            if (event.kind == PointerEventKind.cancel) { root.cancel-drag(); }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.dragged) { root.drop-drag(); }
        }
        moved => {
            if (self.pressed && self.source-index >= 0 && self.action == 0 && root.can-reorder && root.scratchpads && root.query == "") {
                if (!self.dragged && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                    self.dragged = true;root.drag-active = true;root.drag-started(root.results[self.source-index].key);
                }
                if (root.drag-active) { root.update-drag(self.mouse-x,self.mouse-y); }
            }
        }
        clicked => {
            if (!self.dragged && self.source-index >= 0 && self.source-index == root.pointer-index(self.mouse-x,self.mouse-y)) {
                if (self.action == 3) { if (root.results[self.source-index].can-trash) { root.trash(root.results[self.source-index].key); } }
                else if (self.action == 2) { if (root.results[self.source-index].can-promote) { root.promote(root.results[self.source-index].key,false); } }
                else if (self.action == 1 || root.selecting) { root.selection-toggled(root.results[self.source-index].key); }
                else { root.selected-index = self.source-index;root.open-page(root.results[self.source-index].key); }
            }
        }
    }
    Rectangle {
        private property <int> insertion:root.drag-index + (root.drag-after ? 1 : 0);
        x:root.cards ? list.x + mod(self.insertion,root.columns) * list.width / root.columns : list.x;
        y:list.y + floor(self.insertion / root.columns) * root.row-height + list.content-y;
        width:root.cards ? 3px : list.width;
        height:root.cards ? min(root.row-height,list.y + list.visible-height - self.y) : 3px;
        background:root.theme.accent;
        visible:root.drag-active && self.y >= list.y && self.y < list.y + list.visible-height;
    }
    ThemeScrollbar { x:list.x + list.width - self.width;y:list.y;height:list.height;thumb-color:root.theme.scrollbar;content-height:list.content-height;visible-height:list.visible-height;content-y <=> list.content-y; }
    if root.results.length == 0: Rectangle {
        x:24px;y:list.y + 38px;width:parent.width - 48px;height:100px;
        Text { x:0px;y:0px;width:parent.width;height:24px;text:root.busy ? "Working…" : "Nothing found";color:root.theme.muted;font-family:"Menlo";font-size:13px;horizontal-alignment:center; }
        if root.can-create: Rectangle {
            y:38px;width:parent.width;height:38px;border-radius:19px;background:root.theme.surface;
            ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:12px;y:5px;width:parent.width - 24px;theme:root.theme;text:"Create a note starting with “" + root.query + "”";clicked => { root.create(); } }
        }
    }
    Text { x:24px;y:toolbar.y - 34px;width:parent.width - (root.can-load-more ? 152px : 48px);height:30px;text:root.index-status + (root.action-message != "" ? " · " + root.action-message : "");color:root.theme.muted;font-size:12px;wrap:word-wrap;max-lines:2;overflow:elide; }
    ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:parent.width - 120px;y:toolbar.y - 34px;width:100px;theme:root.theme;text:"More pages";visible:root.can-load-more;enabled:!root.busy;clicked => { root.load-more(); } }
    toolbar := SearchToolbar {
        high-contrast:root.high-contrast;material-effects:root.material-effects;
        width:parent.width;y:parent.height - self.height;
        theme:root.theme;scratchpads:root.scratchpads;cards:root.cards;selecting:root.selecting;
        selected-count:root.selected-count;can-promote:root.can-promote;can-trash:root.can-trash;busy:root.busy;
        enabled:root.confirm-count == 0;
        select-toggled => { root.selecting = !root.selecting; root.select-toggled(); }
        scope-changed => { root.scratchpads = !root.scratchpads; root.scope-changed(root.scratchpads); }
        view-changed(value) => { root.cards = value; root.view-changed(value); }
        promote-selected => { root.promote-selected(); }
        trash-selected => { root.trash-selected(); }
    }
    Rectangle {
        visible:root.confirm-count > 0;
        background:root.theme.paper.with-alpha(0.85);
        TouchArea { }
        Rectangle {
            x:16px;y:max(12px,(parent.height - self.height) / 2);width:parent.width - 32px;height:174px;
            border-radius:14px;background:root.theme.surface;border-width:1px;border-color:root.theme.line;
            Text { x:16px;y:16px;width:parent.width - 32px;height:28px;text:"Move " + root.confirm-count + " notes to Trash?";font-size:15px;font-weight:550;color:root.theme.ink; }
            Text { x:16px;y:52px;width:parent.width - 32px;height:62px;text:"You can restore them from Trash. Deletion follows your existing SilverBullet sync settings.";wrap:word-wrap;font-size:12px;color:root.theme.muted; }
            ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:16px;y:128px;width:92px;theme:root.theme;text:"Cancel";clicked => { root.trash-cancelled(); query-input.focus(); } }
            confirm-button := ChoiceButton { high-contrast:root.high-contrast; material-effects:root.material-effects; height:28px; x:parent.width - 154px;y:128px;width:138px;theme:root.theme;text:"Move to Trash";clicked => { root.trash-confirmed(root.confirm-id); } }
        }
    }
}

import { ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { UiTheme, ThemeOption, ThemePair } from "../types.slint";
import { ActionButton, ChoiceButton } from "action-button.slint";
component ThemeCard inherits FocusScope {
    in property <UiTheme> theme;
    in property <ThemeOption> option;
    in property <bool> selected;
    callback clicked();
    min-height: 78px;
    preferred-height: 78px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: root.option.name + (root.selected ? ", selected" : "");
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    Rectangle {
        background: root.option.palette.paper;
        border-radius: 7px;
        border-width: root.selected || root.has-focus ? 2px : 1px;
        border-color: root.selected || root.has-focus ? root.theme.accent : root.theme.line;
        Text {
            x: 12px;
            y: 10px;
            text: "Aa";
            font-family: "Menlo";
            font-size: 16px;
            color: root.option.palette.ink;
        }

        Rectangle {
            x: 43px;
            y: 22px;
            width: 26px;
            height: 2px;
            background: root.option.palette.accent;
        }

        Text {
            x: 12px;
            y: 46px;
            width: max(1px,parent.width - (root.selected ? 90px : 24px));
            overflow: elide;
            text: root.option.name;
            font-size: 11px;
            color: root.option.palette.ink;
        }

        Text {
            x: parent.width - 66px;
            y: 48px;
            width: 54px;
            text: root.selected ? "Selected" : "";
            horizontal-alignment: right;
            font-size: 9px;
            color: root.option.palette.muted;
        }

        TouchArea {
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

export component AppearancePanel inherits Rectangle {
    in property <UiTheme> theme;
    in property <[ThemePair]> theme-pairs;
    in property <string> selected-theme;
    in-out property <string> mode:"system";
    in-out property <string> paper-style:"plain";
    in-out property <float> font-size-px:15;
    in property <string> message;
    in property <bool> low-contrast-warning:false;
    callback return-to-note();
    callback changed();
    callback theme-selected(string);
    callback import-theme();
    callback export-theme();
    callback apply-low-contrast();
    callback cancel-theme-import();
    public function focus-panel() { system-button.focus(); }
    background: root.theme.paper;
    Text {
        x: 24px;
        y: 14px;
        text: "Appearance";
        font-size: 17px;
        font-weight: 550;
        color: root.theme.ink;
    }

    ActionButton {
        x: parent.width - 44px;
        y: 9px;
        theme: root.theme;
        icon: @image-url("../../assets/icons/close.svg");
        label: "Return to note";
        clicked => { root.return-to-note(); }
    }

    scroll := ScrollView {
        x: 24px;
        y: 53px;
        width: parent.width - 48px;
        height: parent.height - 101px;
        content-width: self.visible-width;
        content-height: content.preferred-height;
        content := VerticalBox {
            width: scroll.visible-width;
            padding: 0px;
            spacing: 12px;
            Rectangle {
                height: 34px;
                background: root.theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.theme.line;
                HorizontalBox {
                    padding: 3px;
                    spacing: 3px;
                    ChoiceButton {
                        text: "Light";
                        theme: root.theme;
                        selected: root.mode == "light";
                        clicked => { root.mode = "light"; root.changed(); }
                    }

                    ChoiceButton {
                        text: "Dark";
                        theme: root.theme;
                        selected: root.mode == "dark";
                        clicked => { root.mode = "dark"; root.changed(); }
                    }

                    system-button := ChoiceButton {
                        text: "System";
                        theme: root.theme;
                        selected: root.mode == "system";
                        clicked => { root.mode = "system"; root.changed(); }
                    }
                }
            }

            Text {
                text: root.mode == "system" ? "Follows macOS · light and dark choices are saved separately" : "Your light and dark choices are saved separately";
                font-size: 10px;
                color: root.theme.muted;
                wrap: word-wrap;
            }

            Text {
                text: "THEME";
                font-size: 10px;
                font-weight: 600;
                color: root.theme.muted;
            }

            for pair in root.theme-pairs: HorizontalBox {
                padding: 0px;
                spacing: 10px;
                height: 78px;
                ThemeCard {
                    theme: root.theme;
                    option: pair.left;
                    selected: root.selected-theme == pair.left.id;
                    clicked => { root.theme-selected(pair.left.id); }
                }

                ThemeCard {
                    theme: root.theme;
                    option: pair.right;
                    selected: root.selected-theme == pair.right.id;
                    visible: pair.has-right;
                    clicked => { root.theme-selected(pair.right.id); }
                }
            }
            Text {
                text: "PAPER";
                font-size: 10px;
                font-weight: 600;
                color: root.theme.muted;
            }

            HorizontalBox {
                padding: 0px;
                spacing: 4px;
                ChoiceButton {
                    text: "Plain";
                    theme: root.theme;
                    selected: root.paper-style == "plain";
                    clicked => { root.paper-style = "plain"; root.changed(); }
                }

                ChoiceButton {
                    text: "Dots";
                    theme: root.theme;
                    selected: root.paper-style == "dots";
                    clicked => { root.paper-style = "dots"; root.changed(); }
                }

                ChoiceButton {
                    text: "Ruled";
                    theme: root.theme;
                    selected: root.paper-style == "ruled";
                    clicked => { root.paper-style = "ruled"; root.changed(); }
                }

                ChoiceButton {
                    text: "Grid";
                    theme: root.theme;
                    selected: root.paper-style == "grid";
                    clicked => { root.paper-style = "grid"; root.changed(); }
                }
            }

            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                Text {
                    text: "Text size";
                    font-size: 11px;
                    color: root.theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                ChoiceButton {
                    text: "−";
                    label: "Decrease text size";
                    theme: root.theme;
                    width: 32px;
                    horizontal-stretch: 0;
                    accessible-label: "Decrease text size";
                    clicked => { root.font-size-px = max(11,root.font-size-px - 1); root.changed(); }
                }

                Text {
                    text: root.font-size-px + " px";
                    font-size: 11px;
                    color: root.theme.muted;
                    width: 38px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ChoiceButton {
                    text: "+";
                    label: "Increase text size";
                    theme: root.theme;
                    width: 32px;
                    horizontal-stretch: 0;
                    accessible-label: "Increase text size";
                    clicked => { root.font-size-px = min(24,root.font-size-px + 1); root.changed(); }
                }
            }

            Text {
                visible: root.message != "";
                text: root.message;
                color: root.theme.ink;
                font-size: 11px;
                wrap: word-wrap;
            }

            if root.low-contrast-warning:VerticalBox {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: "This theme has low contrast. Text or controls may be difficult to see.";
                    color: root.theme.ink;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    ChoiceButton {
                        text: "Cancel";
                        theme: root.theme;
                        clicked => { root.cancel-theme-import(); }
                    }

                    ChoiceButton {
                        text: "Apply anyway";
                        theme: root.theme;
                        clicked => { root.apply-low-contrast(); }
                    }
                }
            }
        }
    }

    HorizontalBox {
        x: 24px;
        y: parent.height - 39px;
        width: parent.width - 48px;
        height: 29px;
        padding: 0px;
        spacing: 8px;
        ChoiceButton {
            text: "Import theme…";
            theme: root.theme;
            clicked => { root.import-theme(); }
        }

        ChoiceButton {
            text: "Export theme…";
            theme: root.theme;
            clicked => { root.export-theme(); }
        }
    }
}

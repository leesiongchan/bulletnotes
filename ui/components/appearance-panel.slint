import { Theme, Typography, Radius, Spacing } from "theme.slint";
import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SettingsGroup, SettingsHeading, SettingToggle } from "settings-controls.slint";
import { PaperSurface } from "paper-surface.slint";
import { ThemeScrollView } from "theme-scroll-view.slint";
import { ThemeOption, ThemePair, SettingsCategory, UiAppearanceMode, UiPaperIntensity, UiPaperStyle, UiPaperType } from "../types.slint";
import { ActionButton, ChoiceButton, ChoiceOption } from "action-button.slint";
component ThemeAssignmentButton inherits FocusScope {
    in property <bool> light-selected;
    in property <bool> dark-selected;
    in property <string> name;
    callback clicked();
    width:32px; height:32px;
    private property <string> assignment:root.light-selected && root.dark-selected ? "Both" : root.light-selected ? "Light" : root.dark-selected ? "Dark" : "Unassigned";
    private property <string> next-assignment:root.light-selected && !root.dark-selected ? "Dark" : root.dark-selected && !root.light-selected ? "Both" : "Light";
    accessible-role:button;
    accessible-label:root.name + ", " + root.assignment + ". Assign to " + root.next-assignment;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    Rectangle {
        border-radius:Radius.control;
        border-width:root.has-focus ? 3px : Theme.high-contrast ? 2px : 1px;
        border-color:root.has-focus ? Theme.palette.ink : Theme.palette.line;
        background:root.light-selected || root.dark-selected || touch.has-hover ? Theme.palette.selection : Theme.palette.paper;
        Image {
            source:root.light-selected && root.dark-selected ? @image-url("../../assets/icons/sun-moon.svg") : root.dark-selected ? @image-url("../../assets/icons/moon.svg") : @image-url("../../assets/icons/sun.svg");
            colorize:Theme.palette.ink;
            x:8px; y:8px; width:16px; height:16px;
        }
        touch := TouchArea { clicked => { root.focus(); root.clicked(); } }
    }
    Tooltip { text: @markdown("\{root.name}: assign to \{root.next-assignment} mode"); }
}
component ThemeCard inherits FocusScope {
    in property <ThemeOption> option;
    in property <UiPaperType> paper-type;
    in property <UiPaperStyle> paper-style;
    in property <float> font-size-px;
    in property <bool> light-selected;
    in property <bool> dark-selected;
    in property <length> size:150px;
    in property <int> focus-generation;
    callback clicked();
    callback cycled();
    changed focus-generation => { if (root.focus-generation > 0) { root.focus(); } }
    width:root.size; height:root.size;
    accessible-role:button;
    accessible-label:root.option.name;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    Rectangle {
        border-radius:Radius.card; clip:true;
        PaperSurface {
            width:parent.width; height:parent.height; theme:root.option.palette;
            paper-type:root.paper-type; paper-style:root.paper-style; font-size-px:root.font-size-px;
        }
        TouchArea { clicked => { root.focus(); root.clicked(); } }
        Text {
            x:12px; y:12px; width:parent.width - 64px; height:42px;
            text:root.option.name; font-family:Typography.mono; font-size:Typography.small;
            color:root.option.palette.ink; wrap:word-wrap; max-lines:2; overflow:elide;
        }
        Rectangle {
            x:12px; y:parent.height - 32px; width:parent.width - 24px; height:20px;
            accessible-role:none;
            HorizontalLayout {
                spacing:0px; padding:0px;
                for shade in [root.option.swatches.primary, root.option.swatches.secondary, root.option.swatches.tertiary, root.option.swatches.accent2, root.option.swatches.accent3, root.option.swatches.accent4, root.option.swatches.accent5, root.option.swatches.highlight]: Rectangle {
                    background:shade; horizontal-stretch:1; accessible-role:none;
                }
            }
            Rectangle {
                border-width:1px;
                border-color:Theme.high-contrast ? (root.option.palette.dark ? white : black) : root.option.palette.line.with-alpha(0.4);
                background:transparent; accessible-role:none;
            }
        }
        Rectangle {
            border-radius:Radius.card;
            border-width:root.light-selected || root.dark-selected || root.has-focus ? 2px : 1px;
            border-color:Theme.high-contrast || root.has-focus ? (root.option.palette.dark ? white : black) : root.light-selected || root.dark-selected ? Theme.palette.accent : Theme.palette.line.with-alpha(0.3);
            background:transparent; accessible-role:none;
        }
        ThemeAssignmentButton {
            x:parent.width - 44px; y:10px;
            name:root.option.name;
            light-selected:root.light-selected; dark-selected:root.dark-selected;
            clicked => { root.cycled(); }
        }
    }
}

export component AppearancePanel inherits Rectangle {
    in property <string> light-theme;
    in property <string> dark-theme;
    in property <[ThemePair]> theme-pairs;
    in property <bool> reduce-transparency:false;
    in-out property <SettingsCategory> category:SettingsCategory.appearance;
    in-out property <UiAppearanceMode> mode:UiAppearanceMode.system;
    in-out property <UiPaperStyle> paper-style:UiPaperStyle.plain;
    in-out property <UiPaperType> paper-type:UiPaperType.smooth;
    in-out property <UiPaperIntensity> paper-intensity:UiPaperIntensity.clear;
    in-out property <float> font-size-px:15;
    in-out property <bool> start-with-new-note:false;
    in-out property <bool> keep-bottom-bar-visible:false;
    in-out property <bool> show-note-count:true;
    in-out property <bool> show-note-date:true;
    in-out property <bool> show-newest-indicator:true;
    in property <string> message;
    in property <bool> low-contrast-warning:false;
    in-out property <string> hotkey-accelerator;
    in property <string> native-message;
    in property <bool> hotkey-busy:false;
    callback return-to-note();
    callback show-connection();
    callback show-recovery();
    callback apply-hotkey();
    callback changed();
    callback theme-selected(string);
    callback cycle-theme-assignment(string);
    callback import-theme();
    callback export-theme();
    callback apply-low-contrast();
    callback cancel-theme-import();
    private property <length> inset:root.width >= 696px ? 48px : 20px;
    public function focus-panel() { if (root.category == SettingsCategory.general) { general-tab.focus(); } else { appearance-tab.focus(); } }
    private property <int> theme-focus-generation:0;
    public function reveal-themes() { root.category = SettingsCategory.appearance; scroll.content-y = -max(0px,theme-heading.y - 12px); root.theme-focus-generation += 1; }
    changed category => { scroll.content-y = 0px; }
    background:transparent;
    Text { x:root.inset; y:14px; text:"Settings"; font-size:Typography.title; font-weight:600; color:Theme.palette.ink; }
    ActionButton {
        x:parent.width - 44px; y:9px;
        icon:@image-url("../../assets/icons/close.svg"); label:"Return to note";
        clicked => { root.return-to-note(); }
    }
    Rectangle {
        x:root.inset; y:54px; width:parent.width - 2 * root.inset; height:38px;
        background:Theme.palette.surface; border-radius:9px;
        HorizontalLayout {
            padding:Spacing.xs; spacing:Spacing.xs;
            general-tab := ChoiceOption {
                text:"General"; material-effects:false;
                selected:root.category == SettingsCategory.general;
                clicked => { root.category = SettingsCategory.general; }
            }
            appearance-tab := ChoiceOption {
                text:"Appearance"; material-effects:false;
                selected:root.category == SettingsCategory.appearance;
                clicked => { root.category = SettingsCategory.appearance; }
            }
        }
    }
    scroll := ThemeScrollView {
        scrollbar-color:Theme.palette.scrollbar;
        x:root.inset; y:112px;
        width:parent.width - 2 * root.inset;
        height:max(1px,parent.height - 158px);
        content-width:self.visible-width;
        content-height:content.preferred-height;
        content := VerticalBox {
            x:0px; width:max(1px,scroll.visible-width - 12px); padding:0px; spacing:Spacing.xl;
            if root.category == SettingsCategory.general: VerticalBox {
                padding:0px; spacing:Spacing.xl;
                SettingsHeading {text:"Startup";}
                SettingsGroup {
                    SettingToggle {
                        label:"Start with a new note";
                        description:"Open a fresh scratchpad on launch. Your previous notes stay saved.";
                        checked <=> root.start-with-new-note;
                        toggled => {root.changed();}
                    }
                }
                SettingsHeading {text:"Global shortcut";}
                SettingsGroup {
                    Text {text:"Show or hide Bulletnotes from any app."; font-size:Typography.body; color:Theme.palette.ink; wrap:word-wrap;}
                    Rectangle {
                        height:34px; background:Theme.palette.paper;
                        border-width:1px; border-color:Theme.palette.line; border-radius:Radius.tight;
                        TextInput {
                            x:8px; width:parent.width - 16px; height:parent.height;
                            text <=> root.hotkey-accelerator; single-line:true; vertical-alignment:center;
                            color:Theme.palette.ink; font-size:Typography.body;
                            selection-background-color:Theme.palette.selection; selection-foreground-color:Theme.palette.ink;
                            read-only:root.hotkey-busy; accessible-label:"Global show and hide shortcut";
                        }
                    }
                    Text {text:"For example, Option+A on macOS or Control+Shift+Space."; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
                    ChoiceButton {
                        material-effects:false;
                        text:root.hotkey-busy ? "Saving shortcut…" : "Apply shortcut"; enabled:!root.hotkey-busy;
                        clicked => {root.apply-hotkey();}
                    }
                    Text {visible:root.native-message != ""; text:root.native-message; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
                }
                SettingsHeading {text:"Sync";}
                SettingsGroup {
                    Text {text:"SilverBullet connection"; font-size:Typography.body; color:Theme.palette.ink;}
                    Text {text:"Notes save locally and sync with your connected space. Manage the server and credentials here."; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
                    ChoiceButton {
                        text:"Connection…"; material-effects:false;
                        clicked => {root.show-connection();}
                    }
                }
                SettingsHeading {text:"Recovery";}
                SettingsGroup {
                    Text {text:"Restore deleted notes, review sync conflicts, or recover a kept version."; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
                    ChoiceButton {
                        text:"Open recovery…"; label:"Changes, Trash, and kept versions";
                        material-effects:false;
                        clicked => {root.show-recovery();}
                    }
                }
            }
            appearance-content := VerticalBox {
                visible:root.category == SettingsCategory.appearance;
                padding:0px; spacing:Spacing.xl;
                SettingsHeading {text:"Text";}
                SettingsGroup {
                    HorizontalLayout {
                        spacing:Spacing.md;
                        Text {text:"Text size"; font-size:Typography.body; color:Theme.palette.ink; vertical-alignment:center; horizontal-stretch:1;}
                        ChoiceButton {text:"−"; label:"Decrease text size"; material-effects:false; width:32px; horizontal-stretch:0; enabled:root.font-size-px > 11; clicked => {root.font-size-px = max(11,root.font-size-px - 1); root.changed();}}
                        Text {text:root.font-size-px + " pt"; font-size:Typography.body; color:Theme.palette.muted; width:40px; horizontal-alignment:center; vertical-alignment:center;}
                        ChoiceButton {text:"+"; label:"Increase text size"; material-effects:false; width:32px; horizontal-stretch:0; enabled:root.font-size-px < 24; clicked => {root.font-size-px = min(24,root.font-size-px + 1); root.changed();}}
                    }
                }
                SettingsHeading {text:"Paper";}
                SettingsGroup {
                    Text {text:"Paper type"; font-size:Typography.body; font-weight:600; color:Theme.palette.ink;}
                    Rectangle {
                        height:80px; background:Theme.palette.paper; border-radius:Radius.control; clip:true;
                        PaperSurface {
                            width:parent.width; height:parent.height;
                            paper-type:root.paper-type; paper-style:root.paper-style; font-size-px:root.font-size-px;
                        }
                        Text {x:16px; y:14px; text:"A little space to think."; font-family:Typography.mono; font-size:Typography.heading; color:Theme.palette.ink;}
                        Text {x:16px; y:43px; width:parent.width - 32px; text:root.paper-type == UiPaperType.bone ? "Bone · fine, understated grain" : root.paper-type == UiPaperType.eggshell ? "Eggshell · soft, organic grain" : root.paper-type == UiPaperType.linen ? "Linen · a woven finish" : "Smooth · an even surface"; font-size:Typography.small; color:Theme.palette.muted; overflow:elide;}
                    }
                    HorizontalLayout {
                        spacing:Spacing.sm;
                        for kind in [UiPaperType.smooth, UiPaperType.bone, UiPaperType.eggshell, UiPaperType.linen]: ChoiceOption {
                            text:kind == UiPaperType.smooth ? "Smooth" : kind == UiPaperType.bone ? "Bone" : kind == UiPaperType.eggshell ? "Eggshell" : "Linen";
                            material-effects:false;
                            selected:root.paper-type == kind;
                            clicked => {root.paper-type = kind; root.changed();}
                        }
                    }
                    Text {text:"Paper type changes the finish. Theme colors stay independent."; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
                    if root.paper-type != UiPaperType.smooth && (Theme.high-contrast || root.reduce-transparency): Text {
                        text:Theme.high-contrast ? "Paper texture is hidden while Increase Contrast is enabled. Your selected finish is saved." : "Paper texture is hidden while Reduce Transparency is enabled. Your selected finish is saved.";
                        font-size:Typography.small; color:Theme.palette.ink; wrap:word-wrap;
                    }
                    Rectangle {height:1px; background:Theme.palette.line.with-alpha(Theme.high-contrast ? 1 : 0.25);}
                    Text {text:"Paper style"; font-size:Typography.body; font-weight:600; color:Theme.palette.ink;}
                    HorizontalLayout {
                        spacing:Spacing.xs;
                        for style in [UiPaperStyle.plain, UiPaperStyle.dots, UiPaperStyle.ruled, UiPaperStyle.grid]: ChoiceOption {
                            text:style == UiPaperStyle.plain ? "Plain" : style == UiPaperStyle.dots ? "Dots" : style == UiPaperStyle.ruled ? "Ruled" : "Grid";
                            material-effects:false;
                            selected:root.paper-style == style;
                            clicked => {root.paper-style = style; root.changed();}
                        }
                    }
                    Text {text:"Paper intensity"; font-size:Typography.body; color:Theme.palette.ink;}
                    HorizontalLayout {
                        spacing:Spacing.xs;
                        for intensity in [UiPaperIntensity.subtle, UiPaperIntensity.clear, UiPaperIntensity.bold]: ChoiceOption {
                            text:intensity == UiPaperIntensity.subtle ? "Subtle" : intensity == UiPaperIntensity.clear ? "Clear" : "Bold";
                            material-effects:false;
                            enabled:root.paper-style != UiPaperStyle.plain;
                            selected:root.paper-intensity == intensity;
                            clicked => {root.paper-intensity = intensity; root.changed();}
                        }
                    }
                    Text {text:"Controls the dots and lines. Choose a paper style to show them."; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
                }
                SettingsHeading {text:"Window";}
                SettingsGroup {
                    SettingToggle {label:"Keep bottom bar visible"; description:"Keep navigation and note details in view while the note is active."; checked <=> root.keep-bottom-bar-visible; toggled => {root.changed();}}
                    SettingToggle {label:"Show note count"; checked <=> root.show-note-count; toggled => {root.changed();}}
                    SettingToggle {label:"Show note date"; checked <=> root.show-note-date; toggled => {root.changed();}}
                }
                SettingsHeading {text:"Appearance";}
                SettingsGroup {
                    HorizontalLayout {
                        spacing:Spacing.xs;
                        for mode in [UiAppearanceMode.light, UiAppearanceMode.dark, UiAppearanceMode.system]: ChoiceOption {
                            text:mode == UiAppearanceMode.light ? "Light" : mode == UiAppearanceMode.dark ? "Dark" : "System";
                            material-effects:false;
                            selected:root.mode == mode;
                            clicked => {root.mode = mode; root.changed();}
                        }
                    }
                    Text {text:root.mode == UiAppearanceMode.system ? "Follows system appearance. Light and dark themes are saved separately." : "Light and dark themes are saved separately."; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
                }
            theme-heading := Text {
                text: "Themes";
                font-size: Typography.body;
                font-weight: 600;
                color: Theme.palette.ink;
            }

            gallery := Rectangle {
                private property <int> columns:self.width >= 640px ? 4 : 2;
                private property <length> card-size:min(168px,(self.width - 32px - (self.columns - 1) * 16px) / self.columns);
                private property <int> rows:ceil(root.theme-pairs.length * 2 / self.columns);
                private property <length> left-inset:(self.width - self.columns * self.card-size - (self.columns - 1) * 16px) / 2;
                height:32px + self.rows * self.card-size + max(0,self.rows - 1) * 16px;
                background:Theme.palette.surface; border-radius:Radius.group;
                for pair[index] in root.theme-pairs: Rectangle {
                    width:parent.width; height:parent.height; accessible-role:none;
                    ThemeCard {
                        size:gallery.card-size;
                        x:gallery.left-inset + mod(index * 2,gallery.columns) * (gallery.card-size + 16px);
                        y:16px + floor(index * 2 / gallery.columns) * (gallery.card-size + 16px);
                        paper-type:root.paper-type; paper-style:root.paper-style; font-size-px:root.font-size-px;
                        focus-generation:index == 0 ? root.theme-focus-generation : 0;
                        option:pair.left; light-selected:root.light-theme == pair.left.id; dark-selected:root.dark-theme == pair.left.id;
                        clicked => { root.theme-selected(pair.left.id); }
                        cycled => { root.cycle-theme-assignment(pair.left.id); }
                    }
                    ThemeCard {
                        size:gallery.card-size;
                        x:gallery.left-inset + mod(index * 2 + 1,gallery.columns) * (gallery.card-size + 16px);
                        y:16px + floor((index * 2 + 1) / gallery.columns) * (gallery.card-size + 16px);
                        paper-type:root.paper-type; paper-style:root.paper-style; font-size-px:root.font-size-px;
                        option:pair.right; visible:pair.has-right;
                        light-selected:root.light-theme == pair.right.id; dark-selected:root.dark-theme == pair.right.id;
                        clicked => { root.theme-selected(pair.right.id); }
                        cycled => { root.cycle-theme-assignment(pair.right.id); }
                    }
                }
            }
            Rectangle {
                height:68px; background:Theme.palette.surface; border-radius:Radius.group;
                Text {x:10px;y:10px;text:"Custom themes";font-size:Typography.body;color:Theme.palette.ink;}
                Text {x:10px;y:35px;width:max(1px,parent.width - 200px);text:"Import or export a palette";font-size:Typography.body;color:Theme.palette.muted;wrap:word-wrap;}
                HorizontalBox {
                    x:parent.width - 184px; y:21px; width:174px; height:28px; padding:0px; spacing:Spacing.md;
                    ChoiceButton { text:"Import…";label:"Import theme";clicked => {root.import-theme();}}
                    ChoiceButton { text:"Export…";label:"Export theme";clicked => {root.export-theme();}}
                }
            }
            if root.low-contrast-warning:VerticalBox {
                padding: 10px;
                spacing: Spacing.md;
                Text {
                    text: "This theme has low contrast. Text or controls may be difficult to see.";
                    color: Theme.palette.ink;
                    font-size: Typography.body;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: Spacing.md;
                    ChoiceButton {
                        text: "Cancel";
                        clicked => { root.cancel-theme-import(); }
                    }

                    ChoiceButton {
                        text: "Apply anyway";
                        clicked => { root.apply-low-contrast(); }
                    }
                }
            }
            }
        }
    }
    Text {
        x:root.inset; y:parent.height - 37px; width:parent.width - 2 * root.inset; height:32px;
        text:root.message; color:Theme.palette.muted; font-size:Typography.small; wrap:word-wrap; overflow:elide;
        vertical-alignment:center;
    }
}

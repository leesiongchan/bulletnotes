export component ThemeScrollbar inherits Rectangle {
    in property <color> thumb-color;
    in property <length> content-height;
    in property <length> visible-height;
    in-out property <length> content-y;
    private property <length> maximum:max(0px,root.content-height - root.visible-height);
    private property <length> travel:max(1px,root.height - thumb.height - 4px);
    width: 12px;
    visible: root.maximum > 0px;
    accessible-role: slider;
    accessible-label: "Vertical scroll position";
    accessible-value: -root.content-y / 1px;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum / 1px;
    accessible-value-step: 40;
    accessible-action-increment => { root.content-y = max(-root.maximum,root.content-y - 40px); }
    accessible-action-decrement => { root.content-y = min(0px,root.content-y + 40px); }
    thumb := Rectangle {
        x: 3px;
        y: 2px + root.travel * clamp(-root.content-y / max(1px,root.maximum),0,1);
        width: 6px;
        height: min(root.height - 4px,max(24px,(root.height - 4px) * root.visible-height / max(1px,root.content-height)));
        border-radius: 3px;
        background: root.thumb-color;
    }
    TouchArea {
        private property <length> pressed-value;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                if (self.mouse-y < thumb.y || self.mouse-y > thumb.y + thumb.height) {
                    root.content-y = -root.maximum * clamp((self.mouse-y - 2px - thumb.height / 2) / root.travel,0,1);
                }
                self.pressed-value = root.content-y;
            }
        }
        moved => {
            if (self.pressed) {
                root.content-y = clamp(self.pressed-value - (self.mouse-y - self.pressed-y) * root.maximum / root.travel,-root.maximum,0px);
            }
        }
        scroll-event(event) => {
            root.content-y = clamp(root.content-y + event.delta-y,-root.maximum,0px);
            return event.delta-y != 0px ? accept : reject;
        }
    }
}

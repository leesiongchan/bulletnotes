import { Theme, Typography, Radius, Spacing } from "theme.slint";
export component SettingsGroup inherits Rectangle {
    background:Theme.palette.surface;
    border-radius:Radius.group;
    min-height:content.min-height;
    preferred-height:content.preferred-height;
    content := VerticalLayout { padding:14px; spacing:Spacing.lg; @children }
}
export component SettingsHeading inherits Text {
    color:Theme.palette.ink;
    font-size:Typography.heading;
    font-weight:600;
}
export component SettingToggle inherits FocusScope {
    in property <string> label;
    in property <string> description;
    in-out property <bool> checked;
    callback toggled();
    min-height:max(42px,copy.preferred-height + 12px);
    preferred-height:self.min-height;
    accessible-role:switch;
    accessible-checkable:true;
    accessible-label:root.label;
    accessible-description:root.description;
    accessible-checked:root.checked;
    accessible-enabled:root.enabled;
    function toggle() { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }
    accessible-action-default => { root.toggle(); }
    key-pressed(event) => {
        if (event.text == " " || event.text == Key.Return) { root.toggle(); return accept; }
        return reject;
    }
    copy := VerticalLayout {
        y:(root.height - self.preferred-height) / 2;
        width:max(1px,parent.width - 58px);
        height:self.preferred-height;
        spacing:Spacing.xs;
        Text {text:root.label; font-size:Typography.body; color:Theme.palette.ink; wrap:word-wrap;}
        Text {visible:root.description != ""; text:root.description; font-size:Typography.small; color:Theme.palette.muted; wrap:word-wrap;}
    }
    Rectangle {
        x:parent.width - 38px; y:(parent.height - 22px) / 2;
        width:38px; height:22px; border-radius:self.height / 2;
        background:root.checked ? Theme.palette.accent : Theme.palette.line.with-alpha(Theme.high-contrast ? 1 : 0.35);
        border-width:root.has-focus || Theme.high-contrast ? 2px : 0px;
        border-color:root.has-focus ? Theme.palette.ink : Theme.palette.line;
        Rectangle {
            x:root.checked ? 19px : 3px; y:3px; width:16px; height:16px;
            border-radius:self.height / 2; background:Theme.palette.dark ? Theme.palette.ink : Theme.palette.paper;
        }
    }
    TouchArea {enabled:root.enabled; clicked => {root.focus(); root.toggle();}}
}

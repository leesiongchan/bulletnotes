import { Theme, Typography, Radius } from "theme.slint";
import { PageRow } from "../types.slint";
import { ActionButton } from "action-button.slint";

export component SearchResult inherits FocusScope {
    in property <PageRow> data;
    in property <bool> selected;
    in property <bool> selecting;
    in property <bool> cards;
    in property <int> columns:1;
    in property <bool> busy;
    private property <bool> pending-focus:false;
    in property <bool> hovered;
    callback opened();
    callback toggled();
    callback promote(bool);
    callback trash();
    callback step(int);
    accessible-role: button;
    // In select mode activation toggles the row, so it reports its checked state.
    accessible-checkable: root.selecting;
    accessible-checked: root.selecting && root.data.checked;
    accessible-label: root.data.title + ", " + root.data.path + ", " + root.data.availability;
    accessible-action-default => { if (root.selecting) { root.toggled(); } else { root.opened(); } }
    changed selected => { root.pending-focus = root.selected; if (root.selected) { root.focus(); } }
    init => { root.pending-focus = root.selected; }
    // Virtualized rows receive focus after the newly revealed row has a layout.
    Timer { interval:16ms;running:root.pending-focus;triggered => { root.pending-focus = false; if (root.selected) { root.focus(); } } }
    key-pressed(event) => {
        if (root.busy) { return reject; }
        if (event.text == Key.Return) {
            if (event.modifiers.shift && root.data.can-promote) { root.promote(true); }
            else if (!event.modifiers.shift) { root.opened(); }
            return accept;
        }
        if (event.text == " " && root.selecting) { root.toggled(); return accept; }
        if (event.text == Key.DownArrow) { root.step(root.columns); return accept; }
        if (event.text == Key.UpArrow) { root.step(-root.columns); return accept; }
        if (root.cards && event.text == Key.RightArrow) { root.step(1); return accept; }
        if (root.cards && event.text == Key.LeftArrow) { root.step(-1); return accept; }
        return reject;
    }
    Rectangle {
        x:6px; y:6px; width:parent.width - 12px; height:parent.height - 12px;
        border-radius:Radius.surface;
        background:root.data.checked || root.selected || root.hovered ? Theme.palette.selection : (root.cards ? Theme.palette.surface : transparent);
        border-width:root.has-focus ? 2px : (root.cards ? 1px : 0px);
        border-color:root.has-focus ? Theme.palette.accent : Theme.palette.line;
        Text {
            x:root.selecting ? 40px : 14px; y:12px;
            width:parent.width - self.x - (root.cards ? 14px : 86px);
            height:root.cards ? min(150px,max(48px,parent.height - 76px)) : 48px;
            text:root.cards ? (root.data.excerpt != "" ? root.data.excerpt : root.data.title) : (root.data.list-excerpt != "" ? root.data.list-excerpt : root.data.excerpt != "" ? root.data.excerpt : root.data.title);
            text-decorations:root.cards ? root.data.excerpt-highlights : root.data.list-excerpt-highlights;
            font-family:Typography.mono; font-size:Typography.body;
            color:Theme.palette.ink; wrap:word-wrap; max-lines:root.cards ? 9 : 3; overflow:elide;
        }
        Text {
            x:14px; y:parent.height - 38px; width:parent.width - (root.cards || root.data.availability == "Cached" ? 28px : 104px);
            height:16px; text:root.data.path; text-decorations:root.data.path-highlights;
            font-size:Typography.small; color:Theme.palette.muted; overflow:elide;
        }
        Text {
            x:14px; y:parent.height - 21px; width:parent.width - 88px; height:14px;
            text:root.data.modified-label; font-size:Typography.caption; color:Theme.palette.muted; overflow:elide;
        }
        Text {
            x:parent.width - 82px; y:root.cards ? parent.height - 57px : 64px; width:68px; height:14px;
            text:root.data.availability == "Cached" ? "" : root.data.availability;
            font-size:Typography.caption; color:Theme.palette.muted; horizontal-alignment:right; overflow:elide;
        }
        ActionButton {
            x:8px;y:10px;visible:root.selecting;enabled:!root.busy;
            icon:root.data.checked ? @image-url("../../assets/icons/select.svg") : @image-url("../../assets/icons/circle.svg");selected:root.data.checked;
            label:root.data.checked ? "Deselect note" : "Select note"; clicked => { root.toggled(); }
        }
        ActionButton {
            x:parent.width - 76px;y:root.cards ? parent.height - 27px : 27px;
            icon:@image-url("../../assets/icons/newest.svg");label:"Promote to front";
            visible:root.data.can-promote;enabled:!root.busy;clicked => { root.promote(false); }
        }
        ActionButton {
            x:parent.width - 42px;y:root.cards ? parent.height - 27px : 27px;
            icon:@image-url("../../assets/icons/trash.svg");
            label:root.data.can-trash ? "Move to Trash" : root.data.trash-disabled-reason;
            enabled:root.data.can-trash && !root.busy;clicked => { root.trash(); }
        }
    }
}

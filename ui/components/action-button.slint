import { UiTheme } from "../types.slint";
export component ActionButton inherits FocusScope {
    in property <UiTheme> theme;
    in property <image> icon;
    in property <string> label;
    in property <bool> selected:false;
    in property <bool> circular:false;
    in property <bool> high-contrast:false;
    in property <bool> material-effects:true;
    out property <bool> pressed:touch.pressed;
    callback clicked();
    width: root.circular ? 32px : 28px;
    height: root.circular ? 32px : 28px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Return || event.text == " ")) { root.clicked(); return accept; }
        return reject;
    }
    Rectangle {
        border-radius: root.circular ? self.height / 2 : 7px;
        background: root.selected || touch.pressed || touch.has-hover ? root.theme.selection : transparent;
        border-width: root.has-focus ? 2px : (root.high-contrast && root.circular ? 1px : 0px);
        border-color: root.has-focus ? root.theme.accent : (root.high-contrast ? root.theme.ink : root.theme.line.with-alpha(0.3));
        Image {
            source: root.icon;
            colorize: root.enabled ? root.theme.ink : root.theme.muted;
            opacity: root.enabled ? 1 : 0.45;
            width: 18px;
            height: 18px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.focus(); root.clicked(); }
        }
    }
    Tooltip { text: @markdown("\{root.label}"); }
}

export component ChoiceButton inherits FocusScope {
    in property <UiTheme> theme;
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> selected:false;
    in property <bool> high-contrast:false;
    in property <bool> material-effects:true;
    callback clicked();
    min-height: 28px;
    preferred-height: 28px;
    min-width: 32px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    key-pressed(event) => { if (root.enabled && (event.text == Key.Return || event.text == " ")) { root.clicked(); return accept; } return reject; }
    Rectangle {
        border-radius: 7px;
        background: root.selected || touch.pressed || touch.has-hover ? root.theme.selection : (root.material-effects && !root.high-contrast ? @linear-gradient(180deg, root.theme.surface, root.theme.paper) : root.theme.paper);
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus || root.selected ? root.theme.accent : (root.high-contrast ? root.theme.ink : root.theme.line.with-alpha(0.4));
        Text {
            text: root.text;
            overflow: elide;
            color: root.selected ? root.theme.ink : root.theme.muted;
            font-size: 13px;
            font-weight: root.selected ? 550 : 400;
            opacity: root.enabled ? 1 : 0.5;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.focus(); root.clicked(); }
        }
    }
    Tooltip { text: @markdown("\{root.label}"); }
}

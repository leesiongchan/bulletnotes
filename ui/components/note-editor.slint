import { PaperMaterial } from "paper-material.slint";
import { ThemeScrollView } from "theme-scroll-view.slint";
import { UiTheme, MarkdownCommand, MarkdownEdit } from "../types.slint";
export component NoteEditor inherits Rectangle {
    in property <UiTheme> theme;
    in property <bool> paper-material:false;
    in-out property <string> text;
    in property <[TextInputDecoration]> decorations;
    in property <[TextInputMarker]> markers;
    in property <float> font-size-px:15;
    in property <string> paper-style:"plain";
    in property <bool> read-only:false;
    in property <length> top-clearance:16px;
    out property <float> scroll-y:-scroll.content-y / 1px;
    out property <length> line-height:root.font-size-px * 1.6px;
    private property <float> line-factor:root.line-height / max(1px,measure-one.font-metrics.ascent - measure-one.font-metrics.descent);
    out property <int> selection-anchor: input.anchor-position-byte-offset;
    out property <int> selection-caret: input.cursor-position-byte-offset;
    private property <bool> suppress-caret-reveal: false;
    pure callback edit-markdown(string, int, int, MarkdownCommand, int, int) -> MarkdownEdit;
    function apply-command(command: MarkdownCommand, marker-start: int, marker-end: int) -> EventResult {
        if (!input.source-edits-allowed) { return reject; }
        let edit = root.edit-markdown(root.text,input.anchor-position-byte-offset,input.cursor-position-byte-offset,command,marker-start,marker-end);
        if (!edit.handled) { return reject; }
        if (edit.changed) {
            root.suppress-caret-reveal = edit.preserve-scroll;
            input.apply-source-edit(edit.start,edit.end,edit.replacement,edit.anchor,edit.caret);
            root.suppress-caret-reveal = false;
        }
        return accept;
    }
    function command-key(event: KeyEvent) -> EventResult {
        if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
            if (!event.modifiers.shift && (event.text == "b" || event.text == "B")) { return root.apply-command(MarkdownCommand.bold,-1,-1); }
            if (!event.modifiers.shift && (event.text == "i" || event.text == "I")) { return root.apply-command(MarkdownCommand.italic,-1,-1); }
            if (event.modifiers.shift && (event.text == "x" || event.text == "X")) { return root.apply-command(MarkdownCommand.strikethrough,-1,-1); }
            if (event.modifiers.shift && (event.text == "h" || event.text == "H")) { return root.apply-command(MarkdownCommand.cycle-heading,-1,-1); }
            if (event.modifiers.shift && (event.text == "k" || event.text == "K")) { return root.apply-command(MarkdownCommand.toggle-task,-1,-1); }
        }
        if (event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.shift) {
            if (event.text == Key.UpArrow) { return root.apply-command(MarkdownCommand.move-up,-1,-1); }
            if (event.text == Key.DownArrow) { return root.apply-command(MarkdownCommand.move-down,-1,-1); }
        }
        if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
            if (event.text == Key.Return && !event.modifiers.shift) { return root.apply-command(MarkdownCommand.continue-list,-1,-1); }
            if (event.text == Key.Tab) { return root.apply-command(event.modifiers.shift ? MarkdownCommand.outdent-list : MarkdownCommand.indent-list,-1,-1); }
            if (event.text == Key.Backtab) { return root.apply-command(MarkdownCommand.outdent-list,-1,-1); }
        }
        return reject;
    }
    callback edited(string);
    callback move-to-trash();
    callback key-pressed(KeyEvent) -> EventResult;
    public function select-match(anchor:int, caret:int) { input.set-selection-offsets(anchor,caret); }
    public function focus-editor() { input.focus(); }
    public function restore-selection(anchor: int, caret: int, y: float) { input.set-selection-offsets(anchor,caret); scroll.content-y = -max(0,y) * 1px; }
    background: root.theme.paper;
    clip: true;
    PaperMaterial { width:parent.width; height:parent.height; active:root.paper-material; tint:root.theme.ink; strength:root.theme.dark ? 0.015 : 0.005; }
    measure-one := Text {
        visible: false;
        text: "Ag";
        font-family: "Menlo";
        font-size: root.font-size-px * 1px;
        line-height-factor: 1;
        wrap: no-wrap;
    }

    private property <length> decoration-step:root.paper-style == "ruled" || root.paper-style == "grid" ? root.line-height : 18px;
    private property <int> first-row:floor((-scroll.content-y - (root.paper-style == "ruled" ? root.top-clearance : root.paper-style == "grid" ? 5.35px : 0px)) / root.decoration-step);
    private property <int> rows:ceil(root.height / root.decoration-step) + 2;
    private property <int> columns:ceil(root.width / root.decoration-step) + 1;
    for row in root.rows: Rectangle {
        y: scroll.content-y + (root.first-row + row + 1) * root.decoration-step + (root.paper-style == "ruled" ? root.top-clearance - 3px : root.paper-style == "grid" ? 5.35px : -3px);
        height: root.paper-style == "dots" ? 2px : root.paper-style == "grid" ? max(0.5px,1phx) : 1px;
        width: parent.width;
        visible: root.paper-style != "plain";
        accessible-role: none;
        background: root.paper-style == "ruled" || root.paper-style == "grid" ? root.theme.pattern : transparent;
        for col in root.columns: Rectangle {
            visible: root.paper-style == "dots";
            x: col * 18px + 8px;
            width: 1.5px;
            height: 1.5px;
            border-radius: 1px;
            background: root.theme.pattern;
            accessible-role: none;
        }
    }
    for col in root.columns: Rectangle {
        visible: root.paper-style == "grid";
        x: col * root.decoration-step;
        width: max(0.5px,1phx);
        height: parent.height;
        background: root.theme.pattern;
        accessible-role: none;
    }
    context := ContextMenuArea {
        Menu {
            MenuItem { title:"Move note to Trash"; enabled:!root.read-only; activated => { root.move-to-trash(); } }
            MenuSeparator {}
            MenuItem {
                title: "Undo";
                enabled: !root.read-only;
                activated => { input.undo(); }
            }

            MenuItem {
                title: "Redo";
                enabled: !root.read-only;
                activated => { input.redo(); }
            }

            MenuItem {
                title: "Cut";
                enabled: !root.read-only;
                activated => { input.cut(); }
            }

            MenuItem {
                title: "Copy";
                enabled: !root.text.is-empty;
                activated => { input.copy(); }
            }

            MenuItem {
                title: "Paste";
                enabled: !root.read-only;
                activated => { input.paste(); }
            }

            MenuItem {
                title: "Select All";
                enabled: !root.text.is-empty;
                activated => { input.select-all(); }
            }
        }

        scroll := ThemeScrollView {
            scrollbar-color: root.theme.scrollbar;
            width: parent.width;
            height: parent.height;
            content-width: self.visible-width;
            content-height: max(self.visible-height,input.preferred-height + root.top-clearance + 64px);
            input := TextInput {
                x: 45px;
                y: root.top-clearance;
                width: max(1px,scroll.visible-width - 90px);
                height: max(scroll.visible-height - root.top-clearance - 64px,self.preferred-height);
                text <=> root.text;
                text-decorations: root.decorations;
                text-markers: root.markers;
                single-line: false;
                preserve-selection-on-focus-loss: true;
                wrap: word-wrap;
                read-only: root.read-only;
                font-family: "Menlo";
                font-size: root.font-size-px * 1px;
                line-height-factor: root.line-factor;
                color: root.theme.ink;
                selection-background-color: root.theme.cursor;
                selection-foreground-color: root.theme.ink;
                input-method-hints: { capitalization:none, auto-correct:false, auto-complete:false };
                page-height: scroll.visible-height;
                accessible-label: "Markdown note";
                marker-activated(start,end) => { root.apply-command(MarkdownCommand.toggle-task,start,end); }
                edited => { root.edited(self.text); }
                key-pressed(event) => {
                    if (root.command-key(event) == accept) { return accept; }
                    return root.key-pressed(event);
                }
                cursor-position-changed(pos) => {
                    if (!root.suppress-caret-reveal) {
                    if (pos.y + self.y + scroll.content-y < 0px) { scroll.content-y = min(0px,-pos.y - self.y); }
                    else if (pos.y + self.y + scroll.content-y > scroll.visible-height - root.line-height) { scroll.content-y = min(0px,scroll.visible-height - pos.y - self.y - root.line-height); }
                    }
                }
            }
        }
    }
}
